<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sh2="clr-namespace:Tune.App.Shell"
                    xmlns:p2="clr-namespace:Tune.App.Platform">

    <!-- ===== palette ===== -->
    <Color x:Key="BaseColor">#121212</Color>
    <Color x:Key="SidebarColor">#000000</Color>
    <Color x:Key="CardColor">#181818</Color>
    <Color x:Key="CardHoverColor">#282828</Color>
    <Color x:Key="AccentColor">#1DB954</Color>
    <Color x:Key="HeaderColor">#2A2140</Color>

    <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource BaseColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E1DB954" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="Black" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#B3B3B3" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="TrackBrush" Color="#4D4D4D" />
    <SolidColorBrush x:Key="PlayerBarBrush" Color="#181818" />
    <SolidColorBrush x:Key="DividerBrush" Color="#282828" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Nirmala UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== text ===== -->
    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style x:Key="Title1" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,40,0,16" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="Subtle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>
    <!-- the one style for small section labels ("YOUR LIBRARY", "APPEARANCE"…) -->
    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>

    <!-- ===== icon buttons (Segoe Fluent Icons glyph as Content) ===== -->
    <Style x:Key="IconButton" TargetType="Button">
        <!-- icon-only: expose the tooltip text as the accessible name (screen readers, UI automation) -->
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="18">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- toggled state: green, like Spotify's active shuffle/repeat -->
    <Style x:Key="ToggleIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Style.Triggers>
            <Trigger Property="Tag" Value="On">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- round white play button -->
    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="White" CornerRadius="19" RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- big green play button (headers, card hover) -->
    <Style x:Key="AccentPlayButton" TargetType="Button" BasedOn="{StaticResource PlayButton}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{DynamicResource AccentBrush}" CornerRadius="24" RenderTransformOrigin="0.5,0.5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.45" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- default look for plain text buttons ("Update now", "Retry"…): outlined pill -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" BorderBrush="#7A7A7A" BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- window caption buttons (custom title bar) -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#22FFFFFF" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- big sidebar entry: icon tile (glows in the accent colour when active) + label -->
    <Style x:Key="NavItem" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="14" Padding="8,7">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="tile" Width="40" Height="40" CornerRadius="12" Background="#14FFFFFF">
                                <TextBlock x:Name="icon" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static sh2:NavGlyph.Instance}}"
                                           FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="bg" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={x:Static sh2:NavIsOn.Instance}}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="tile" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            <Setter TargetName="tile" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="22" ShadowDepth="0" Opacity="0.85" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- library entry: same geometry and type as NavItem, art in the tile, song count below the name -->
    <Style x:Key="LibraryItem" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="14" Padding="8,7">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="12" Background="#14FFFFFF" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource SubtleTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Width="40" Height="40" Stretch="UniformToFill" p2:Art.Url="{Binding ThumbnailUrl}">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,40,40" RadiusX="12" RadiusY="12" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="140">
                                <TextBlock x:Name="name" Text="{Binding Name}" Style="{StaticResource TextBase}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}" />
                                <TextBlock Text="{Binding Count, Converter={x:Static sh2:SongCountConverter.Instance}}" Style="{StaticResource Caption}" FontSize="12" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="bg" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="Tag" Value="On">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="bg" Property="Background" Value="#1FFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- sidebar navigation entries -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="12,9">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="bg" Property="Background" Value="#1A1A1A" />
                        </Trigger>
                        <Trigger Property="Tag" Value="On">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="bg" Property="Background" Value="#232323" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== thin slider (seek / volume) ===== -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="14" Height="14" Background="Transparent">
                        <Ellipse x:Name="dot" Width="12" Height="12" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.55" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                            <Setter TargetName="dot" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.17" ScaleY="1.17" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" Height="12">
                        <Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ThinSlider" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <!-- press anywhere and drag; see Platform/SliderDrag -->
        <Setter Property="p2:SliderDrag.Enabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="16" Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="fill" Style="{StaticResource SliderRepeat}" Background="White" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Background="{DynamicResource TrackBrush}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="thumb" Style="{StaticResource ThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fill" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== slim overlay scrollbars ===== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="b" Background="#5A5A5A" CornerRadius="4" Opacity="0.6" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Margin="1">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" Margin="1">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== text box (search) ===== -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="#242424" CornerRadius="22" BorderBrush="Transparent" BorderThickness="2" Padding="40,0,16,0" Height="44">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            <TextBlock x:Name="hint" Text="What do you want to play?" Style="{StaticResource Subtle}" FontSize="14"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Margin="2,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#2A2A2A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- top search pill in the title row -->
    <Style x:Key="TopSearchBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="#B0000000" CornerRadius="19" BorderBrush="#33FFFFFF" BorderThickness="1.5" Padding="40,0,16,0" Height="38">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            <TextBlock x:Name="hint" Text="Search songs, artists, albums…  (Ctrl+K)" Style="{StaticResource Subtle}" FontSize="13"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Margin="2,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="#66FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== dark context menus ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#282828" CornerRadius="6" Padding="4" BorderBrush="#333" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="#EAEAEA" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="b" Background="Transparent" CornerRadius="3" Padding="12,8" MinWidth="190">
                            <DockPanel>
                                <TextBlock x:Name="arrow" DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           VerticalAlignment="Center" Visibility="Collapsed" Margin="12,0,0,0" />
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </DockPanel>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                            <Border Background="#282828" CornerRadius="6" Padding="4" BorderBrush="#333" BorderThickness="1">
                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#3E3E3E" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="arrow" Property="Visibility" Value="Visible" />
