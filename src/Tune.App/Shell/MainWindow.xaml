<Window x:Class="Tune.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Tune.App.ViewModels"
        xmlns:p="clr-namespace:Tune.App.Platform"
        xmlns:sh="clr-namespace:Tune.App.Shell"
        xmlns:views="clr-namespace:Tune.App.Views"
        Title="Tune" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="{DynamicResource BaseBrush}" Foreground="White"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <views:Views />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <sh:NullToVisibilityConverter x:Key="NullToVis" />
        <sh:EqualsToTagConverter x:Key="EqualsToTag" />

        <!-- sidebar "you" entry: same geometry as NavItem, your avatar in the tile -->
        <Style x:Key="ProfileNavItem" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="14" Padding="8,7">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="40" Height="40">
                                    <Ellipse x:Name="ring" Margin="-3" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Visibility="Collapsed" />
                                    <Ellipse Fill="#14FFFFFF" />
                                    <p:Icon Data="{StaticResource IcoPerson}" Foreground="{TemplateBinding Foreground}" Size="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsSignedIn, Converter={x:Static sh:InverseBoolToVisConverter.Instance}}" />
                                    <Grid Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                                        <Ellipse Fill="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding AccountInitial}" Foreground="{DynamicResource OnAccentBrush}" FontFamily="{StaticResource UiFont}"
                                                   FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Ellipse Visibility="{Binding AccountPhoto, Converter={StaticResource NullToVis}}">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding AccountPhoto, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                </Grid>
                                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding AccountNavTitle}" Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource UiFont}" FontSize="15"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                    <TextBlock Text="Account &amp; settings" Style="{StaticResource Caption}" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding NavKey}" Value="settings">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- pages: views are matched to page view models -->
        <DataTemplate DataType="{x:Type vm:PlaceholderPage}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Title1}" Margin="32,8" />
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- optional top tint: spans sidebar and pages so the window stays one surface -->
        <!-- solid colour faded by an eased mask: blends smoothly into the page (no grey band or hard edge) -->
        <Border Grid.ColumnSpan="2" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush x:Name="HeaderFill" Color="Transparent" />
            </Border.Background>
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF000000" Offset="0" />
                    <GradientStop Color="#DB000000" Offset="0.1" />
                    <GradientStop Color="#A3000000" Offset="0.2" />
                    <GradientStop Color="#6B000000" Offset="0.3" />
                    <GradientStop Color="#3D000000" Offset="0.4" />
                    <GradientStop Color="#1C000000" Offset="0.5" />
                    <GradientStop Color="#08000000" Offset="0.6" />
                    <GradientStop Color="#00000000" Offset="0.72" />
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>

        <!-- ===================== sidebar ===================== -->
        <Border Grid.Row="0" Grid.Column="0" Background="Transparent">
            <DockPanel Margin="12,0,12,8">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Height="56" Margin="12,4,0,14">
                        <Image Source="{x:Static p:AppIcon.Logo}" Width="30" Height="30" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Tune" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBase}" />
                    </StackPanel>

                    <Button Style="{StaticResource NavItem}" Command="{Binding GoToCommand}" CommandParameter="home" AutomationProperties.Name="Home"
                            Tag="{Binding NavKey, Converter={x:Static sh:NavTagConverter.Instance}, ConverterParameter=home|&#xE80F;}" Content="Home" />
                    <Button Style="{StaticResource NavItem}" Command="{Binding GoToCommand}" CommandParameter="search" AutomationProperties.Name="Search"
                            Tag="{Binding NavKey, Converter={x:Static sh:NavTagConverter.Instance}, ConverterParameter=search|&#xE721;}" Content="Search" />
                    <Button Style="{StaticResource NavItem}" Command="{Binding GoToCommand}" CommandParameter="liked" AutomationProperties.Name="Liked songs"
                            Tag="{Binding NavKey, Converter={x:Static sh:NavTagConverter.Instance}, ConverterParameter=liked|&#xEB52;}" Content="Liked songs" />
                    <Button Style="{StaticResource NavItem}" Command="{Binding GoToCommand}" CommandParameter="downloads" AutomationProperties.Name="Downloads"
                            Tag="{Binding NavKey, Converter={x:Static sh:NavTagConverter.Instance}, ConverterParameter=downloads|&#xE896;}" Content="Downloads" />
                    <Button Style="{StaticResource NavItem}" Command="{Binding GoToCommand}" CommandParameter="history" AutomationProperties.Name="History"
                            Tag="{Binding NavKey, Converter={x:Static sh:NavTagConverter.Instance}, ConverterParameter=history|&#xE81C;}" Content="History" />
                    <!-- you: account on top, settings below (one page) -->
                    <Button Style="{StaticResource ProfileNavItem}" Command="{Binding GoToCommand}" CommandParameter="settings" AutomationProperties.Name="Profile and settings"
                            ToolTip="Account and settings" />

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="8,14" />
                    <DockPanel Margin="16,0,4,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="13" Width="28" Height="28"
                                ToolTip="New playlist" Click="NewPlaylist_Click" />
                        <TextBlock Text="YOUR LIBRARY" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,104">
                    <ItemsControl ItemsSource="{Binding Playlists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource LibraryItem}" MouseRightButtonUp="SidebarPlaylist_RightClick"
                                        Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{x:Static sh:PlaylistNavTagConverter.Instance}">
                                            <Binding Path="DataContext.NavKey" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            <Binding Path="Id" />
                                        </MultiBinding>
                                    </Button.Tag>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== main area ===================== -->
        <Grid Grid.Row="0" Grid.Column="1" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- title bar: back + window buttons (the empty area drags the window) -->
            <DockPanel Grid.Row="0" Margin="16,0,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="Min_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize" Click="Max_Click" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Background="#66000000" Foreground="White" FontSize="12"
                            Width="32" Height="32" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip="Back" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Background="#66000000" Foreground="White" FontSize="12"
                            Width="32" Height="32" Margin="8,0,16,0" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip="Forward" />
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="12,0" Height="28" VerticalAlignment="Center"
                            Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}" Cursor="Hand"
                            ToolTip="No internet — downloaded songs still play" MouseLeftButtonUp="OfflinePill_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xF384;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Offline" Style="{StaticResource Body}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- a new Tune release is out: one click downloads it and restarts -->
                    <Button Command="{Binding InstallUpdateCommand}" Cursor="Hand" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Update Tune"
                            ToolTip="{Binding AvailableUpdate.Title}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{DynamicResource AccentBrush}" CornerRadius="14" Padding="12,0" Height="28">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding UpdateButtonText}" FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource OnAccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- hidden behind Now Playing: nothing shows through its edges or reacts to the pointer -->
            <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding Page}" Focusable="False"
                            Visibility="{Binding NowPlaying.IsOpen, Converter={x:Static sh:InverseBoolToVisConverter.Instance}}">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageSlide" />
                </ContentControl.RenderTransform>
            </ContentControl>

        </Grid>

        <!-- now playing + lyrics and the queue share the content area side by side (queue on the right) -->
        <Grid Grid.Column="1" Margin="4,52,16,114">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <views:NowPlayingView DataContext="{Binding NowPlaying}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
            <views:QueuePanel x:Name="QueueHost" Grid.Column="1" Width="370" Margin="12,0,0,0" DataContext="{Binding Queue}"
                              Visibility="{Binding DataContext.IsQueueOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- toast (above everything in the content area) -->
        <Border Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,118"
                Background="{DynamicResource AccentBrush}" CornerRadius="20" Padding="18,10" IsHitTestVisible="False"
                Visibility="{Binding Toast, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{Binding Toast}" Style="{StaticResource Body}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" />
        </Border>

        <!-- ===================== player bar ===================== -->
        <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="88" Margin="14,0,14,14" CornerRadius="22"
                Background="#EE161616" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" DataContext="{Binding Player}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" />
            </Border.Effect>
            <Grid Margin="14,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="200" />
                    <ColumnDefinition Width="4*" MaxWidth="720" />
                    <ColumnDefinition Width="3*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <!-- now playing -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}">
                    <Grid Width="62" Height="62">
                        <Ellipse Fill="#0B0B0B" />
                        <Grid Width="62" Height="62">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="DiscSpin" CenterX="31" CenterY="31" />
                            </Grid.RenderTransform>
                            <Image x:Name="Disc" Width="62" Height="62" Stretch="UniformToFill" p:Art.Url="{Binding ArtUrl}" Cursor="Hand" ToolTip="Now playing and lyrics" MouseLeftButtonUp="Disc_Click">
                                <Image.Clip>
                                    <EllipseGeometry Center="31,31" RadiusX="31" RadiusY="31" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                        <Ellipse Width="62" Height="62" Stroke="{DynamicResource AccentBorderBrush}" StrokeThickness="1.5" />
                        <Ellipse Width="12" Height="12" Fill="#121212" Stroke="#40FFFFFF" StrokeThickness="1" />
                    </Grid>
                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center" MaxWidth="220">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" ToolTip="{Binding Title}" />
                        <p:ArtistLinks Artists="{Binding Track.Artists}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource ToggleIconButton}" Command="{Binding ToggleLikeCommand}" ToolTip="Save to Liked songs"
                            p:LikePop.Enabled="True" Tag="{Binding IsLiked, Converter={x:Static sh:BoolToOnConverter.Instance}}">
                        <p:Icon Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static sh:OnOffIconConverter.Instance}, ConverterParameter=IcoHeart|IcoHeartOutline}" />
                    </Button>
                    <Button Style="{StaticResource ToggleIconButton}" Command="{Binding DownloadSongCommand}"
                            ToolTip="{Binding DownloadTip}" Tag="{Binding DownloadTag}" AutomationProperties.Name="Download song">
                        <p:Icon Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static sh:OnOffIconConverter.Instance}, ConverterParameter=IcoDownloadDone|IcoDownload}" />
                    </Button>
                </StackPanel>

                <!-- transport + seek -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource ToggleIconButton}" Tag="{Binding ShuffleTag}" Command="{Binding ToggleShuffleCommand}" ToolTip="Shuffle">
                            <p:Icon Data="{StaticResource IcoShuffle}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}" Margin="8,0" ToolTip="Previous">
                            <p:Icon Data="{StaticResource IcoPrev}" Size="24" />
                        </Button>
                        <Button Style="{StaticResource PlayButton}" Command="{Binding PlayPauseCommand}" ToolTip="Play/Pause">
                            <p:Icon Data="{Binding PlayIconKey, Converter={x:Static sh:IconKeyConverter.Instance}}" Size="22" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}" Margin="8,0" ToolTip="Next">
                            <p:Icon Data="{StaticResource IcoNext}" Size="24" />
                        </Button>
                        <Button Style="{StaticResource ToggleIconButton}" Tag="{Binding RepeatTag}" Command="{Binding CycleRepeatCommand}" ToolTip="{Binding RepeatTip}">
                            <p:Icon Data="{Binding RepeatIconKey, Converter={x:Static sh:IconKeyConverter.Instance}}" />
                        </Button>
                    </StackPanel>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0"
                                Maximum="{Binding Duration}" Value="{Binding Position, Mode=OneWay}" VerticalAlignment="Center"
                                p:SliderDrag.DragStarted="Seek_Started" p:SliderDrag.DragCompleted="Seek_Completed"
                                ValueChanged="Seek_ValueChanged" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>

                <!-- right: sleep timer, queue, now playing, mini-player, volume -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SleepButton" Style="{StaticResource ToggleIconButton}" ToolTip="{Binding SleepTip}"
                            Tag="{Binding SleepTag}" Click="Sleep_Click" AutomationProperties.Name="Sleep timer">
                        <p:Icon Data="{StaticResource IcoSleep}" Size="19" />
                    </Button>
                    <Button Style="{StaticResource ToggleIconButton}" ToolTip="Queue"
                            Command="{Binding DataContext.ToggleQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Tag="{Binding DataContext.IsQueueOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static sh:BoolToOnConverter.Instance}}">
                        <p:Icon Data="{StaticResource IcoQueue}" />
                    </Button>
                    <Button Style="{StaticResource ToggleIconButton}" ToolTip="Lyrics (F)"
                            Command="{Binding DataContext.NowPlaying.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Tag="{Binding DataContext.NowPlaying.IsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static sh:BoolToOnConverter.Instance}}">
                        <p:Icon Data="{StaticResource IcoLyrics}" />
                    </Button>
                    <Button x:Name="MiniButton" Style="{StaticResource IconButton}" ToolTip="Mini-player" Click="Mini_Click">
                        <p:Icon Data="{StaticResource IcoMini}" />
                    </Button>
                    <p:Icon Data="{StaticResource IcoVolume}" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="8,0" />
                    <Slider Width="100" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== first-run setup overlay ===================== -->
        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#F2121212"
              Visibility="{Binding IsSettingUp, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                <TextBlock Text="Setting up Tune" Style="{StaticResource Title1}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding SetupText}" Style="{StaticResource Subtle}" HorizontalAlignment="Center" Margin="0,12,0,18" />
                <ProgressBar Height="4" Value="{Binding SetupProgress}" IsIndeterminate="{Binding SetupIndeterminate}"
                             Foreground="{DynamicResource AccentBrush}" Background="#333" BorderThickness="0" />
                <TextBlock Text="This only happens once." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                <StackPanel Visibility="{Binding SetupError, Converter={StaticResource NullToVis}}" Margin="0,18,0,0">
                    <TextBlock Text="{Binding SetupError}" Style="{StaticResource Subtle}" Foreground="#FF8A80" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Content="Try again" Command="{Binding RetrySetupCommand}" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="18,8" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
