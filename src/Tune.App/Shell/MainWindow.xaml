<Window x:Class="Tune.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Tune.App.ViewModels"
        xmlns:p="clr-namespace:Tune.App.Platform"
        xmlns:sh="clr-namespace:Tune.App.Shell"
        xmlns:views="clr-namespace:Tune.App.Views"
        Title="Tune" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="{DynamicResource BaseBrush}" Foreground="White"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <views:Views />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <sh:NullToVisibilityConverter x:Key="NullToVis" />
        <sh:EqualsToTagConverter x:Key="EqualsToTag" />

        <!-- pages: views are matched to page view models -->
        <DataTemplate DataType="{x:Type vm:PlaceholderPage}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Title1}" Margin="32,8" />
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== sidebar ===================== -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <DockPanel Margin="12,0,12,8">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Height="56" Margin="12,4,0,14">
                        <Image Source="{x:Static p:AppIcon.Logo}" Width="30" Height="30" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Tune" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBase}" />
                    </StackPanel>

                    <Button Style="{StaticResource NavItem}" Command="{Binding GoToCommand}" CommandParameter="home" AutomationProperties.Name="Home"
                            Tag="{Binding NavKey, Converter={x:Static sh:NavTagConverter.Instance}, ConverterParameter=home|&#xE80F;}" Content="Home" />
                    <Button Style="{StaticResource NavItem}" Command="{Binding GoToCommand}" CommandParameter="search" AutomationProperties.Name="Search"
                            Tag="{Binding NavKey, Converter={x:Static sh:NavTagConverter.Instance}, ConverterParameter=search|&#xE721;}" Content="Search" />
                    <Button Style="{StaticResource NavItem}" Command="{Binding GoToCommand}" CommandParameter="liked" AutomationProperties.Name="Liked songs"
                            Tag="{Binding NavKey, Converter={x:Static sh:NavTagConverter.Instance}, ConverterParameter=liked|&#xEB52;}" Content="Liked songs" />

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="8,14" />
                    <DockPanel Margin="12,0,4,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="13" Width="28" Height="28"
                                ToolTip="New playlist" Click="NewPlaylist_Click" />
                        <TextBlock Text="YOUR LIBRARY" Style="{StaticResource Caption}" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,104">
                    <ItemsControl ItemsSource="{Binding Playlists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButton}" FontWeight="Normal"
                                        Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{x:Static sh:PlaylistNavTagConverter.Instance}">
                                            <Binding Path="DataContext.NavKey" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            <Binding Path="Id" />
                                        </MultiBinding>
                                    </Button.Tag>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="4" Background="#282828" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" Foreground="#7A7A7A"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Width="36" Height="36" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="140">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                                            <TextBlock Text="{Binding Count, Converter={x:Static sh:SongCountConverter.Instance}}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== main area ===================== -->
        <Grid Grid.Row="0" Grid.Column="1" ClipToBounds="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="HeaderStop" Color="#2A2140" Offset="0" />
                    <GradientStop Color="{DynamicResource BaseColor}" Offset="0.45" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- title bar: back + window buttons (the empty area drags the window) -->
            <DockPanel Grid.Row="0" Margin="16,0,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Margin="0,0,8,0"
                            Command="{Binding GoToCommand}" CommandParameter="settings" />
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="Min_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize" Click="Max_Click" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Background="#66000000" Foreground="White" FontSize="12"
                            Width="32" Height="32" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip="Back" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Background="#66000000" Foreground="White" FontSize="12"
                            Width="32" Height="32" Margin="8,0,16,0" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip="Forward" />
                    <Grid Width="420">
                        <TextBox x:Name="TopSearch" Style="{StaticResource TopSearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search box" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="14"
                                   VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
            </DockPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding Page}" Focusable="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageSlide" />
                </ContentControl.RenderTransform>
            </ContentControl>

            <!-- queue panel slides in over the right edge -->
            <views:QueuePanel x:Name="QueueHost" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" Width="360" Margin="0,0,0,104"
                              DataContext="{Binding Queue}"
                              Visibility="{Binding DataContext.IsQueueOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

            <!-- toast -->
            <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,118"
                    Background="{DynamicResource AccentBrush}" CornerRadius="20" Padding="18,10"
                    Visibility="{Binding Toast, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding Toast}" Style="{StaticResource Body}" FontWeight="SemiBold" Foreground="Black" />
            </Border>
        </Grid>

        <!-- ===================== player bar ===================== -->
        <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="88" Margin="14,0,14,14" CornerRadius="22"
                Background="#EE161616" BorderBrush="#22FFFFFF" BorderThickness="1" DataContext="{Binding Player}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" />
            </Border.Effect>
            <Grid Margin="14,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="200" />
                    <ColumnDefinition Width="4*" MaxWidth="720" />
                    <ColumnDefinition Width="3*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <!-- now playing -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}">
                    <Grid Width="62" Height="62">
                        <Ellipse Fill="#0B0B0B" />
                        <Grid Width="62" Height="62">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="DiscSpin" CenterX="31" CenterY="31" />
                            </Grid.RenderTransform>
                            <Image x:Name="Disc" Width="62" Height="62" Stretch="UniformToFill" p:Art.Url="{Binding ArtUrl}">
                                <Image.Clip>
                                    <EllipseGeometry Center="31,31" RadiusX="31" RadiusY="31" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                        <Ellipse Width="62" Height="62" Stroke="#30FFFFFF" StrokeThickness="1" />
                        <Ellipse Width="12" Height="12" Fill="#121212" Stroke="#40FFFFFF" StrokeThickness="1" />
                    </Grid>
                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center" MaxWidth="220">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding ArtistLine}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource ToggleIconButton}" Content="{Binding LikeGlyph}" Command="{Binding ToggleLikeCommand}"
                            ToolTip="Save to Liked songs">
                        <Button.Tag>
                            <Binding Path="IsLiked" Converter="{x:Static sh:BoolToOnConverter.Instance}" />
                        </Button.Tag>
                    </Button>
                </StackPanel>

                <!-- transport + seek -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource ToggleIconButton}" Content="&#xE8B1;" Tag="{Binding ShuffleTag}"
                                Command="{Binding ToggleShuffleCommand}" ToolTip="Shuffle" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" Margin="8,0" ToolTip="Previous" />
                        <Button Style="{StaticResource PlayButton}" Content="{Binding PlayGlyph}" Command="{Binding PlayPauseCommand}" ToolTip="Play/Pause" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding NextCommand}" Margin="8,0" ToolTip="Next" />
                        <Button Style="{StaticResource ToggleIconButton}" Content="{Binding RepeatGlyph}" Tag="{Binding RepeatTag}"
                                Command="{Binding CycleRepeatCommand}" ToolTip="{Binding RepeatTip}" />
                    </StackPanel>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0"
                                Maximum="{Binding Duration}" Value="{Binding Position, Mode=OneWay}" VerticalAlignment="Center"
                                PreviewMouseLeftButtonDown="Seek_MouseDown" PreviewMouseLeftButtonUp="Seek_MouseUp" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>

                <!-- right: queue, mini-player, volume -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToggleIconButton}" Content="&#xE8FD;" ToolTip="Queue"
                            Command="{Binding DataContext.ToggleQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Tag="{Binding DataContext.IsQueueOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static sh:BoolToOnConverter.Instance}}" />
                    <Button x:Name="MiniButton" Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Mini-player" Click="Mini_Click" />
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource SubtleTextBrush}"
                               VerticalAlignment="Center" Margin="8,0" />
                    <Slider Width="100" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== first-run setup overlay ===================== -->
        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#F2121212"
              Visibility="{Binding IsSettingUp, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                <TextBlock Text="Setting up Tune" Style="{StaticResource Title1}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding SetupText}" Style="{StaticResource Subtle}" HorizontalAlignment="Center" Margin="0,12,0,18" />
                <ProgressBar Height="4" Value="{Binding SetupProgress}" IsIndeterminate="{Binding SetupIndeterminate}"
                             Foreground="{DynamicResource AccentBrush}" Background="#333" BorderThickness="0" />
                <TextBlock Text="This only happens once." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                <StackPanel Visibility="{Binding SetupError, Converter={StaticResource NullToVis}}" Margin="0,18,0,0">
                    <TextBlock Text="{Binding SetupError}" Style="{StaticResource Subtle}" Foreground="#FF8A80" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Content="Try again" Command="{Binding RetrySetupCommand}" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="18,8" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
