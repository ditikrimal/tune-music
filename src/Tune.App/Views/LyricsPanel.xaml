<UserControl x:Class="Tune.App.Views.LyricsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="clr-namespace:Tune.App.Shell"
             x:Name="Root">
    <!-- lyrics that follow the song (synced), or plain text, or a status line; DataContext = NowPlayingViewModel -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="LpBoolVis" />
        <sh:NullToVisibilityConverter x:Key="LpNullVis" />
    </UserControl.Resources>
    <Grid>
        <ScrollViewer x:Name="LyricsScroll" VerticalScrollBarVisibility="Hidden" Focusable="False"
                      Visibility="{Binding HasSynced, Converter={StaticResource LpBoolVis}}">
            <ScrollViewer.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0" />
                    <GradientStop Color="Black" Offset="0.12" />
                    <GradientStop Color="Black" Offset="0.82" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </ScrollViewer.OpacityMask>
            <ItemsControl x:Name="LyricsList" ItemsSource="{Binding Lines}" Margin="0,120,0,260">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Cursor="Hand" Focusable="False" HorizontalAlignment="Left" ToolTip="Play from here"
                                Command="{Binding DataContext.SeekToCommand, ElementName=Root}" CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock x:Name="t" Text="{Binding Text}" FontFamily="{StaticResource UiFont}" FontWeight="Bold"
                                               FontSize="{Binding LineSize, ElementName=Root}" TextWrapping="Wrap" Foreground="#59FFFFFF"
                                               Margin="{Binding LineSpacing, ElementName=Root}" Background="Transparent" RenderTransformOrigin="0,0.5">
                                        <TextBlock.RenderTransform>
                                            <ScaleTransform />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Past">
                                            <Setter TargetName="t" Property="Foreground" Value="#8CFFFFFF" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="t" Property="Foreground" Value="#D9FFFFFF" />
                                        </Trigger>
                                        <!-- the sung line: white, eased up a touch -->
                                        <DataTrigger Binding="{Binding State}" Value="Current">
                                            <Setter TargetName="t" Property="Foreground" Value="White" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="t" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.25" />
                                                        <DoubleAnimation Storyboard.TargetName="t" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.25" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="t" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3" />
                                                        <DoubleAnimation Storyboard.TargetName="t" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding PlainLyrics, Converter={StaticResource LpNullVis}}">
            <TextBlock Text="{Binding PlainLyrics}" FontFamily="{StaticResource UiFont}" FontSize="{Binding PlainSize, ElementName=Root}" FontWeight="SemiBold"
                       Foreground="#E6FFFFFF" TextWrapping="Wrap" LineHeight="{Binding PlainLineHeight, ElementName=Root}" Margin="0,40,24,80" />
        </ScrollViewer>

        <TextBlock Text="{Binding Status}" Style="{StaticResource Subtle}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Status, Converter={StaticResource LpNullVis}}" />

        <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Visibility="{Binding Source, Converter={StaticResource LpNullVis}}" />
    </Grid>
</UserControl>
