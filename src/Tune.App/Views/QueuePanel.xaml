<UserControl x:Class="Tune.App.Views.QueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Tune.App.Platform">
    <UserControl.Resources>
        <DataTemplate x:Key="QueueRow">
            <Border x:Name="row" Background="Transparent" CornerRadius="6" Padding="8,6" Cursor="Hand"
                    MouseLeftButtonUp="Row_Click" AllowDrop="True" Drop="Row_Drop" PreviewMouseMove="Row_PreviewMouseMove">
                <DockPanel>
                    <Button x:Name="remove" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11"
                            Width="28" Height="28" Opacity="0" Click="Remove_Click" ToolTip="Remove from queue" />
                    <Border Width="40" Height="40" CornerRadius="4" Background="#282828" ClipToBounds="True">
                        <Image Width="40" Height="40" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="title" Text="{Binding Title}" Style="{StaticResource Body}" />
                        <TextBlock Text="{Binding ArtistLine}" Style="{StaticResource Caption}" FontSize="12" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="#2A2A2A" />
                    <Setter TargetName="remove" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="title" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="remove" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="#0E0E0E" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>
        <DockPanel Margin="12,8,8,8">
            <DockPanel DockPanel.Dock="Top" Margin="8,0,0,8" Height="40">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" Command="{Binding CloseCommand}" ToolTip="Close" />
                <TextBlock Text="Queue" Style="{StaticResource Body}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Now playing" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="8,4,0,6" />
            <ContentControl DockPanel.Dock="Top" Content="{Binding NowPlaying}" ContentTemplate="{StaticResource QueueRow}" Focusable="False" />
            <TextBlock DockPanel.Dock="Top" Text="Next up" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="8,16,0,6" />
            <ListBox ItemsSource="{Binding Upcoming}" ItemTemplate="{StaticResource QueueRow}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
