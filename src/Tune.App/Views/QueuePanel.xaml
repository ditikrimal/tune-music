<UserControl x:Class="Tune.App.Views.QueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Tune.App.Platform"
             xmlns:sh="clr-namespace:Tune.App.Shell"
             WindowChrome.IsHitTestVisibleInChrome="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <sh:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- one queue row: drag handle · art · title/artist · duration · remove -->
        <DataTemplate x:Key="QueueRow">
            <Grid>
                <!-- where a dragged song will land -->
                <Border x:Name="dropLine" Height="2" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}" CornerRadius="1"
                        Margin="8,-1,8,0" Visibility="Collapsed" />
                <Border x:Name="row" Background="Transparent" CornerRadius="10" Padding="4,6,6,6" Cursor="Hand"
                        MouseLeftButtonDown="Row_MouseDown" MouseLeftButtonUp="Row_Click" MouseRightButtonUp="Row_RightClick"
                        PreviewMouseMove="Row_PreviewMouseMove" AllowDrop="True" Drop="Row_Drop" DragEnter="Row_DragEnter" DragLeave="Row_DragLeave">
                    <DockPanel>
                        <p:Icon x:Name="handle" DockPanel.Dock="Left" Data="{StaticResource IcoDrag}" Size="16" Foreground="{DynamicResource SubtleTextBrush}"
                                VerticalAlignment="Center" Margin="2,0,6,0" Opacity="0" />
                        <Button x:Name="remove" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" Opacity="0"
                                Click="Remove_Click" ToolTip="Remove from queue">
                            <p:Icon Data="{StaticResource IcoClose}" Size="16" />
                        </Button>
                        <TextBlock x:Name="dur" DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <Border Width="42" Height="42" CornerRadius="6" Background="#282828" ClipToBounds="True">
                            <Image Width="42" Height="42" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="title" Text="{Binding Title}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Border x:Name="dl" Width="13" Height="13" CornerRadius="7" Background="{DynamicResource AccentBrush}" Margin="0,0,5,0"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                    <p:Icon Data="{StaticResource IcoDownload}" Size="9" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <p:ArtistLinks Artists="{Binding Track.Artists}" Style="{StaticResource Caption}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="#14FFFFFF" />
                    <Setter TargetName="remove" Property="Opacity" Value="1" />
                    <Setter TargetName="handle" Property="Opacity" Value="1" />
                    <Setter TargetName="dur" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger SourceName="row" Property="Tag" Value="drop">
                    <Setter TargetName="dropLine" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                    <Setter TargetName="dl" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                    <Setter TargetName="row" Property="Opacity" Value="0.4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter TargetName="title" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                    <Setter TargetName="title" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="remove" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="handle" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="row" Property="Cursor" Value="Arrow" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="#F2161616" CornerRadius="22" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" />
        </Border.Effect>
        <DockPanel Margin="14,12,10,12">
            <!-- header -->
            <DockPanel DockPanel.Dock="Top" Margin="6,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CloseCommand}" ToolTip="Close queue" Width="34" Height="34">
                    <p:Icon Data="{StaticResource IcoClose}" Size="18" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding ClearCommand}" ToolTip="Clear the queue" Width="34" Height="34"
                        Visibility="{Binding HasUpcoming, Converter={StaticResource BoolToVis}}">
                    <p:Icon Data="{StaticResource IcoClear}" Size="18" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Queue" Style="{StaticResource Body}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Text="NOW PLAYING" Style="{StaticResource SectionLabel}" Margin="8,4,0,6"
                       Visibility="{Binding NowPlaying, Converter={StaticResource NullToVis}}" />
            <ContentControl DockPanel.Dock="Top" Content="{Binding NowPlaying}" ContentTemplate="{StaticResource QueueRow}" Focusable="False"
                            Visibility="{Binding NowPlaying, Converter={StaticResource NullToVis}}" />
            <DockPanel DockPanel.Dock="Top" Margin="8,18,4,6">
                <TextBlock DockPanel.Dock="Right" Text="drag to reorder" Style="{StaticResource Caption}" FontSize="11"
                           Visibility="{Binding HasUpcoming, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="NEXT UP" Style="{StaticResource SectionLabel}" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Nothing queued. Songs like this one will be added automatically." Style="{StaticResource Subtle}"
                       TextWrapping="Wrap" Margin="8,8,8,0"
                       Visibility="{Binding HasUpcoming, Converter={x:Static sh:InverseBoolToVisConverter.Instance}}" />
            <ListBox x:Name="list" ItemsSource="{Binding Upcoming}" ItemTemplate="{StaticResource QueueRow}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
