<UserControl x:Class="Tune.App.Views.ImmersiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Tune.App.Platform"
             xmlns:sh="clr-namespace:Tune.App.Shell"
             xmlns:views="clr-namespace:Tune.App.Views"
             Background="Black" MouseMove="OnActivity" PreviewMouseDown="OnActivity">
    <!-- full screen: the cover's colours fill the screen, big art, lyrics, controls that fade away; DataContext = NowPlayingViewModel -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ImBoolVis" />
        <sh:NullToVisibilityConverter x:Key="ImNullVis" />
        <Style x:Key="BigPlay" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5" x:Name="g">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Ellipse Fill="{DynamicResource AccentBrush}">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="24" ShadowDepth="0" Opacity="0.55" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="g" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="g" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <!-- the cover, blurred into a glow (rendered small and cached: it's blurry anyway, so this costs almost nothing) -->
        <Grid Margin="-240" CacheMode="{x:Static p:Caches.Quarter}">
            <Image Stretch="UniformToFill" p:Art.Url="{Binding Player.ArtUrl}" Opacity="1" RenderOptions.BitmapScalingMode="LowQuality">
                <Image.Effect>
                    <BlurEffect Radius="140" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
        </Grid>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="#59000000" Offset="0.5" />
                    <GradientStop Color="#E0000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.28,0.45" GradientOrigin="0.28,0.45" RadiusX="0.75" RadiusY="0.9">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#66000000" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="56,28,56,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- top: label, exit -->
            <DockPanel x:Name="TopBar">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleFullScreenCommand}" ToolTip="Exit full screen (Esc)" Width="44" Height="44">
                        <p:Icon Data="{StaticResource IcoFullscreenExit}" Size="24" />
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NOW PLAYING" Style="{StaticResource SectionLabel}" Foreground="#B3FFFFFF" />
                    <TextBlock Text="{Binding Player.Track.Album.Title}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4,0,0"
                               Visibility="{Binding Player.Track.Album, Converter={StaticResource ImNullVis}}" />
                </StackPanel>
            </DockPanel>

            <!-- art + lyrics -->
            <Grid Grid.Row="1" Margin="0,12,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ArtColumn" Width="*" />
                    <ColumnDefinition x:Name="LyricsColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <!-- the cover shrinks to leave room for the title on short screens -->
                <Grid x:Name="ArtStack" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Viewbox MaxWidth="560" MaxHeight="560" Stretch="Uniform" HorizontalAlignment="Left">
                        <Grid Width="560" Height="560">
                            <Border CornerRadius="20" Background="#202020" Margin="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="60" ShadowDepth="12" Opacity="0.65" />
                                </Border.Effect>
                            </Border>
                            <Image Width="560" Height="560" Stretch="UniformToFill" p:Art.Url="{Binding Player.ArtUrl}">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,560,560" RadiusX="20" RadiusY="20" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="{Binding Player.Title}" Style="{StaticResource Title1}" FontSize="34" TextWrapping="Wrap" TextTrimming="None" Margin="0,24,0,0" />
                    <p:ArtistLinks Grid.Row="2" Artists="{Binding Player.Track.Artists}" Style="{StaticResource Subtle}" FontSize="18" Foreground="#D9FFFFFF" Margin="0,6,0,0" />
                </Grid>

                <views:LyricsPanel x:Name="Lyrics" Grid.Column="1" Margin="56,0,0,0" LineSize="36" LineSpacing="0,12,0,12" PlainSize="28" PlainLineHeight="46"
                                   Visibility="{Binding ShowLyrics, Converter={StaticResource ImBoolVis}}" />
            </Grid>

            <!-- controls (fade out when the mouse rests) -->
            <StackPanel x:Name="Controls" Grid.Row="2" DataContext="{Binding Player}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PositionText}" Style="{StaticResource Caption}" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                    <Slider x:Name="Seek" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position, Mode=OneWay}"
                            VerticalAlignment="Center" p:SliderDrag.DragStarted="Seek_Started" p:SliderDrag.DragCompleted="Seek_Completed" ValueChanged="Seek_ValueChanged"
                            AutomationProperties.Name="Seek" />
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Caption}" Foreground="#CCFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToggleIconButton}" Command="{Binding ToggleLikeCommand}" ToolTip="Save to Liked songs"
                                p:LikePop.Enabled="True" Tag="{Binding IsLiked, Converter={x:Static sh:BoolToOnConverter.Instance}}">
                            <p:Icon Size="24" Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static sh:OnOffIconConverter.Instance}, ConverterParameter=IcoHeart|IcoHeartOutline}" />
                        </Button>
                        <Button Style="{StaticResource ToggleIconButton}" Command="{Binding DownloadSongCommand}" ToolTip="{Binding DownloadTip}" Tag="{Binding DownloadTag}">
                            <p:Icon Size="22" Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static sh:OnOffIconConverter.Instance}, ConverterParameter=IcoDownloadDone|IcoDownload}" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToggleIconButton}" Tag="{Binding ShuffleTag}" Command="{Binding ToggleShuffleCommand}" ToolTip="Shuffle">
                            <p:Icon Data="{StaticResource IcoShuffle}" Size="22" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}" Margin="18,0" ToolTip="Previous" Width="48" Height="48">
                            <p:Icon Data="{StaticResource IcoPrev}" Size="30" />
                        </Button>
                        <Button Style="{StaticResource BigPlay}" Command="{Binding PlayPauseCommand}" ToolTip="Play/Pause (Space)">
                            <p:Icon Data="{Binding PlayIconKey, Converter={x:Static sh:IconKeyConverter.Instance}}" Size="30" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}" Margin="18,0" ToolTip="Next" Width="48" Height="48">
                            <p:Icon Data="{StaticResource IcoNext}" Size="30" />
                        </Button>
                        <Button Style="{StaticResource ToggleIconButton}" Tag="{Binding RepeatTag}" Command="{Binding CycleRepeatCommand}" ToolTip="{Binding RepeatTip}">
                            <p:Icon Data="{Binding RepeatIconKey, Converter={x:Static sh:IconKeyConverter.Instance}}" Size="22" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToggleIconButton}" ToolTip="Lyrics"
                                Command="{Binding DataContext.ToggleLyricsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Tag="{Binding DataContext.ShowLyrics, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static sh:BoolToOnConverter.Instance}}">
                            <p:Icon Data="{StaticResource IcoLyrics}" Size="22" />
                        </Button>
                        <StackPanel Orientation="Horizontal" Background="Transparent" PreviewMouseWheel="Volume_MouseWheel" ToolTip="Volume (scroll to change)" Margin="6,0,0,0">
                            <p:Icon Data="{StaticResource IcoVolume}" Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="8,0" />
                            <Slider Width="120" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center"
                                    AutomationProperties.Name="Volume" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
