<UserControl x:Class="Tune.App.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Tune.App.Platform"
             xmlns:sh="clr-namespace:Tune.App.Shell">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="NpBoolVis" />
        <sh:NullToVisibilityConverter x:Key="NpNullVis" />
    </UserControl.Resources>

    <Grid x:Name="Panel" ClipToBounds="True" Background="{DynamicResource BaseBrush}" SizeChanged="Panel_SizeChanged">
        <!-- blurred album art backdrop -->
        <Image Stretch="UniformToFill" p:Art.Url="{Binding Player.ArtUrl}" Opacity="0.6" Margin="-120"
               RenderOptions.BitmapScalingMode="LowQuality">
            <Image.Effect>
                <BlurEffect Radius="100" RenderingBias="Performance" />
            </Image.Effect>
        </Image>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#8C000000" Offset="0" />
                    <GradientStop Color="#D9000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="40,16,40,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- top bar -->
            <DockPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Close Now playing (Esc)" Command="{Binding CloseCommand}"
                        Width="40" Height="40" FontSize="16" WindowChrome.IsHitTestVisibleInChrome="True" />
                <TextBlock Text="NOW PLAYING" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </DockPanel>

            <!-- art + lyrics -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
                    <Viewbox MaxWidth="380" MaxHeight="380" Stretch="Uniform">
                        <Grid Width="440" Height="440">
                            <Border CornerRadius="24" Background="#202020" Margin="6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="48" ShadowDepth="10" Opacity="0.6" />
                                </Border.Effect>
                            </Border>
                            <Image Width="440" Height="440" Stretch="UniformToFill" p:Art.Url="{Binding Player.ArtUrl}">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,440,440" RadiusX="24" RadiusY="24" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Viewbox>
                    <TextBlock Text="{Binding Player.Title}" Style="{StaticResource Title1}" FontSize="28" TextWrapping="Wrap" TextTrimming="None" Margin="0,26,0,0" />
                    <p:ArtistLinks Artists="{Binding Player.Track.Artists}" Style="{StaticResource Subtle}" FontSize="18" Margin="0,6,0,0" />
                </StackPanel>

                <!-- lyrics -->
                <Grid Grid.Column="1" Margin="48,0,0,0">
                    <ScrollViewer x:Name="LyricsScroll" VerticalScrollBarVisibility="Hidden" Focusable="False"
                                  Visibility="{Binding HasSynced, Converter={StaticResource NpBoolVis}}">
                        <ScrollViewer.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="Black" Offset="0.12" />
                                <GradientStop Color="Black" Offset="0.82" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </LinearGradientBrush>
                        </ScrollViewer.OpacityMask>
                        <ItemsControl x:Name="LyricsList" ItemsSource="{Binding Lines}" Margin="0,120,0,260">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Cursor="Hand" Focusable="False" HorizontalAlignment="Left" ToolTip="Play from here"
                                            Command="{Binding DataContext.SeekToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock x:Name="t" Text="{Binding Text}" FontFamily="{StaticResource UiFont}" FontSize="26" FontWeight="Bold"
                                                           TextWrapping="Wrap" Foreground="#59FFFFFF" Margin="0,9" Background="Transparent" />
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Past">
                                                        <Setter TargetName="t" Property="Foreground" Value="#8CFFFFFF" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="t" Property="Foreground" Value="#D9FFFFFF" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Current">
                                                        <Setter TargetName="t" Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding PlainLyrics, Converter={StaticResource NpNullVis}}">
                        <TextBlock Text="{Binding PlainLyrics}" FontFamily="{StaticResource UiFont}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="#E6FFFFFF" TextWrapping="Wrap" LineHeight="40" Margin="0,40,24,80" />
                    </ScrollViewer>

                    <TextBlock Text="{Binding Status}" Style="{StaticResource Subtle}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Status, Converter={StaticResource NpNullVis}}" />

                    <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
