<ResourceDictionary x:Class="Tune.App.Views.Views"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Tune.App.ViewModels"
                    xmlns:m="clr-namespace:Tune.Core.Models;assembly=Tune.Core"
                    xmlns:p="clr-namespace:Tune.App.Platform"
                    xmlns:sh="clr-namespace:Tune.App.Shell">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <sh:NullToVisibilityConverter x:Key="NullToVis" />

    <!-- ================= song details pop-up (hover) ================= -->
    <DataTemplate x:Key="SongDetails" DataType="{x:Type m:Track}">
        <StackPanel Orientation="Horizontal" Margin="2">
            <Border Width="96" Height="96" CornerRadius="8" Background="#282828" ClipToBounds="True">
                <Image Width="96" Height="96" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}" />
            </Border>
            <StackPanel Margin="14,2,6,0" MaxWidth="260" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" TextTrimming="None" />
                <TextBlock Text="{Binding ArtistLine}" Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Album.Title, StringFormat=Album · {0}}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Visibility="{Binding Album, Converter={StaticResource NullToVis}}" />
                <TextBlock Text="{Binding Duration, Converter={x:Static sh:DurationConverter.Instance}}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
    <Style x:Key="DetailsTip" TargetType="ToolTip">
        <Setter Property="Background" Value="#F0202020" />
        <Setter Property="BorderBrush" Value="#30FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Placement" Value="Right" />
        <Setter Property="HorizontalOffset" Value="8" />
        <Setter Property="ContentTemplate" Value="{StaticResource SongDetails}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}" Margin="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.55" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- small round overlay buttons on card art (like / more) -->
    <Style x:Key="CardOverlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#B0000000" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="On">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= card (album / playlist / artist / song) ================= -->
    <DataTemplate x:Key="CardTemplate" DataType="{x:Type m:Card}">
        <Button x:Name="card" Width="196" Margin="0,0,12,0" Cursor="Hand" Focusable="False" MouseEnter="Card_MouseEnter" RenderTransformOrigin="0.5,0.5"
                MouseRightButtonUp="Card_RightClick"
                Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="14" Padding="12">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-6" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel>
                <Grid Width="172" Height="172">
                    <Grid.ToolTip>
                        <ToolTip Style="{StaticResource DetailsTip}" Content="{Binding Track}"
                                 Visibility="{Binding Track, Converter={StaticResource NullToVis}}" />
                    </Grid.ToolTip>
                    <p:ShadowBox x:Name="artShadow" Blur="14" CornerRadius="12" Margin="-14,-10,-14,-18" Opacity="0.4" />
                    <Border x:Name="artBorder" CornerRadius="12" Background="#282828" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="40" Foreground="#555"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="art" Width="172" Height="172" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,172,172" RadiusX="12" RadiusY="12" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="quick" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                Visibility="{Binding Track, Converter={StaticResource NullToVis}}">
                        <Button x:Name="cardLike" Style="{StaticResource CardOverlayButton}" ToolTip="Save to Liked songs" Click="CardLike_Click" Margin="0,0,6,0" Opacity="0"
                                p:LikePop.Enabled="True">
                            <Button.Tag>
                                <MultiBinding Converter="{x:Static sh:LikedTagConverter.Instance}">
                                    <Binding Path="Track.VideoId" />
                                    <Binding Path="DataContext.LikesVersion" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </Button.Tag>
                            <p:Icon Size="16" Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static sh:OnOffIconConverter.Instance}, ConverterParameter=IcoHeart|IcoHeartOutline}" />
                        </Button>
                        <Button x:Name="cardMore" Style="{StaticResource CardOverlayButton}" ToolTip="More options" Click="CardMore_Click" Opacity="0">
                            <p:Icon Size="16" Data="{StaticResource IcoMore}" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="play" Style="{StaticResource AccentPlayButton}" Content="&#xE768;" Foreground="{DynamicResource OnAccentBrush}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Opacity="0"
                            ToolTip="Play"
                            Command="{Binding DataContext.PlayCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Grid>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,12,0,4" ToolTip="{Binding Title}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Button>
        <DataTemplate.Triggers>
            <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                <Setter TargetName="play" Property="Opacity" Value="1" />
                <Setter TargetName="cardLike" Property="Opacity" Value="1" />
                <Setter TargetName="cardMore" Property="Opacity" Value="1" />
            </Trigger>
            <!-- a liked song keeps its heart showing -->
            <Trigger SourceName="cardLike" Property="Tag" Value="On">
                <Setter TargetName="cardLike" Property="Opacity" Value="1" />
            </Trigger>
            <DataTrigger Binding="{Binding Kind}" Value="Artist">
                <Setter TargetName="artBorder" Property="CornerRadius" Value="86" />
                <Setter TargetName="artShadow" Property="CornerRadius" Value="86" />
                <Setter TargetName="art" Property="Clip">
                    <Setter.Value>
                        <EllipseGeometry Center="86,86" RadiusX="86" RadiusY="86" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= horizontal shelf with ‹ › scroll buttons ================= -->
    <DataTemplate x:Key="ShelfTemplate" DataType="{x:Type m:Shelf}">
        <StackPanel x:Name="shelf" Background="Transparent">
            <DockPanel>
                <StackPanel x:Name="arrows" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10" Opacity="0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="12" Width="30" Height="30" Background="#1F1F1F" Click="ShelfLeft_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="12" Width="30" Height="30" Background="#1F1F1F" Margin="8,0,0,0" Click="ShelfRight_Click" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{DynamicResource ShowAllLink}" Content="Show all" VerticalAlignment="Bottom" Margin="0,0,10,12"
                        Visibility="{Binding More, Converter={StaticResource NullToVis}}" AutomationProperties.Name="Show all"
                        Command="{Binding DataContext.OpenMoreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False"
                          Padding="14,14,14,20" Margin="-14,-14,-14,-12">
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
        <DataTemplate.Triggers>
            <Trigger SourceName="shelf" Property="IsMouseOver" Value="True">
                <Setter TargetName="arrows" Property="Opacity" Value="1" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= Speed dial: pins + most-played, 3 rows of square tiles, paged sideways ================= -->
    <DataTemplate x:Key="SpeedDialTileTemplate" DataType="{x:Type m:Card}">
        <Button Width="168" Height="168" Margin="0,0,12,12" Cursor="Hand" Focusable="False" Click="SpeedDialTile_Click"
                MouseRightButtonUp="Card_RightClick" MouseEnter="Card_MouseEnter" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Subtitle}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="#282828">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,168,168" RadiusX="12" RadiusY="12" />
                        </Grid.Clip>
                        <Image Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}" />
                        <Border VerticalAlignment="Bottom" Height="76">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#D0000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="{Binding Title}" Foreground="White" FontFamily="{StaticResource UiFont}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Margin="11,0,11,10" VerticalAlignment="Bottom" />
                        <!-- pinned: a small pin in the corner -->
                        <Border Width="26" Height="26" CornerRadius="13" Background="#B0000000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}" ToolTip="Pinned">
                            <p:Icon Data="{StaticResource IcoPin}" Size="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="hover" Background="#40000000" Opacity="0">
                            <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <p:Icon Data="{StaticResource IcoPlay}" Size="22" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="SpeedDialShelfTemplate" DataType="{x:Type m:Shelf}">
        <StackPanel x:Name="shelf" Background="Transparent">
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="12" Width="30" Height="30" Background="#1F1F1F" Click="ShelfLeft_Click" ToolTip="Back" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="12" Width="30" Height="30" Background="#1F1F1F" Margin="8,0,0,0" Click="ShelfRight_Click" ToolTip="More" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SpeedDialTileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- two rows, then the next column (a wide window shows many columns) -->
                            <WrapPanel Orientation="Vertical" Height="360" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </DataTemplate>

    <!-- ================= Quick picks: a grid of song rows, 4 per column, paged sideways ================= -->
    <DataTemplate x:Key="QuickPickTemplate" DataType="{x:Type m:Card}">
        <Border x:Name="row" Width="400" Height="64" CornerRadius="10" Background="Transparent" Padding="6" Margin="0,0,10,0" Cursor="Hand"
                MouseLeftButtonUp="QuickPick_Click" MouseRightButtonUp="Card_RightClick" MouseEnter="Card_MouseEnter">
            <DockPanel>
                <Grid DockPanel.Dock="Left" Width="52" Height="52">
                    <Border CornerRadius="6" Background="#282828" ClipToBounds="True">
                        <Image Width="52" Height="52" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}" />
                    </Border>
                    <Border x:Name="playOverlay" CornerRadius="6" Background="#99000000" Opacity="0">
                        <p:Icon Data="{StaticResource IcoPlay}" Size="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <Button x:Name="more" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Opacity="0" Click="CardMore_Click" ToolTip="More options">
                    <p:Icon Data="{StaticResource IcoMore}" Size="18" />
                </Button>
                <StackPanel VerticalAlignment="Center" Margin="12,0,4,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Subtle}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                        <Run Text="{Binding Subtitle, Mode=OneWay}" /><Run x:Name="albumSep" Text=" • " /><Run Text="{Binding Track.Album.Title, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                <Setter TargetName="row" Property="Background" Value="#14FFFFFF" />
                <Setter TargetName="playOverlay" Property="Opacity" Value="1" />
                <Setter TargetName="more" Property="Opacity" Value="1" />
            </Trigger>
            <DataTrigger Binding="{Binding Track.Album}" Value="{x:Null}">
                <Setter TargetName="albumSep" Property="Text" Value="" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="QuickPicksShelfTemplate" DataType="{x:Type m:Shelf}">
        <StackPanel x:Name="shelf" Background="Transparent">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button Style="{DynamicResource HeaderPill}" Content="Play all" Click="QuickPicksPlayAll_Click" Margin="0,0,12,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="12" Width="30" Height="30" Background="#1F1F1F" Click="ShelfLeft_Click" ToolTip="Back" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="12" Width="30" Height="30" Background="#1F1F1F" Margin="8,0,0,0" Click="ShelfRight_Click" ToolTip="More" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource QuickPickTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- fills a column of 4 rows, then the next column -->
                            <WrapPanel Orientation="Vertical" Height="256" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </DataTemplate>

    <!-- ================= featured card: tall, tinted with the art's own colour ================= -->
    <DataTemplate x:Key="FeaturedCardTemplate" DataType="{x:Type m:Card}">
        <Button x:Name="card" Width="210" Height="292" Margin="0,0,18,0" Cursor="Hand" Focusable="False" RenderTransformOrigin="0.5,0.5"
                MouseEnter="Card_MouseEnter" MouseRightButtonUp="Card_RightClick" AutomationProperties.Name="{Binding Title}"
                Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <Button.RenderTransform>
                <TranslateTransform />
            </Button.RenderTransform>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- shadow lives on its own layer so the text/art never get rasterised (stays sharp) -->
                        <p:ShadowBox x:Name="shadow" Blur="18" CornerRadius="26" Opacity="0.35" Margin="-14,-10,-14,-18" />
                        <Border x:Name="tint" CornerRadius="26" Background="{DynamicResource CardHoverBrush}" p:Art.TintFrom="{Binding ThumbnailUrl}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="-8" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Grid Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}" FontSize="18" FontWeight="Bold" TextAlignment="Center"
                               TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextBase}" FontSize="12" Foreground="#CCFFFFFF" TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
                <Grid Grid.Row="1" Width="168" Height="168" VerticalAlignment="Bottom">
                    <p:ShadowBox Blur="16" CornerRadius="18" Margin="-16,-12,-16,-20" Opacity="0.45" />
                    <Border CornerRadius="18" Background="#30000000" ClipToBounds="True">
                        <Image Width="168" Height="168" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,168,168" RadiusX="18" RadiusY="18" />
                            </Image.Clip>
                        </Image>
                    </Border>
                    <Button x:Name="play" Style="{StaticResource AccentPlayButton}" Content="&#xE768;" Foreground="{DynamicResource OnAccentBrush}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Opacity="0" ToolTip="Play"
                            Command="{Binding DataContext.PlayCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Grid>
            </Grid>
        </Button>
        <DataTemplate.Triggers>
            <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                <Setter TargetName="play" Property="Opacity" Value="1" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="FeaturedShelfTemplate" DataType="{x:Type m:Shelf}">
        <StackPanel x:Name="shelf" Background="Transparent">
            <DockPanel>
                <StackPanel x:Name="arrows" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10" Opacity="0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="12" Width="30" Height="30" Background="#1F1F1F" Click="ShelfLeft_Click" ToolTip="Scroll left" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="12" Width="30" Height="30" Background="#1F1F1F" Margin="8,0,0,0" Click="ShelfRight_Click" ToolTip="Scroll right" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False"
                          Padding="16,18,16,26" Margin="-16,-14,-16,-10">
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource FeaturedCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
        <DataTemplate.Triggers>
            <Trigger SourceName="shelf" Property="IsMouseOver" Value="True">
                <Setter TargetName="arrows" Property="Opacity" Value="1" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= one track row ================= -->
    <DataTemplate x:Key="TrackRowTemplate" DataType="{x:Type vm:TrackRowViewModel}">
        <Border x:Name="row" Background="Transparent" CornerRadius="6" Padding="12,6" Height="58" Cursor="Hand"
                MouseLeftButtonUp="TrackRow_Click" MouseRightButtonUp="TrackRow_RightClick" MouseEnter="TrackRow_MouseEnter">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="3*" x:Name="albumCol" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="num" Text="{Binding Number}" Style="{StaticResource Subtle}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="4" Background="#282828" ClipToBounds="True">
                        <Image Width="42" Height="42" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="title" Text="{Binding Title}" Style="{StaticResource Body}">
                            <TextBlock.ToolTip>
                                <ToolTip Style="{StaticResource DetailsTip}" Content="{Binding Track}" />
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <!-- downloaded: accent arrow; waiting/downloading: a dim one -->
                            <Border x:Name="dlBadge" Width="14" Height="14" CornerRadius="7" Background="{DynamicResource AccentBrush}"
                                    Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="{Binding DownloadTip}">
                                <TextBlock x:Name="dlGlyph" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="8" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- live percentage while this song downloads -->
                            <TextBlock Text="{Binding DownloadProgressText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <p:ArtistLinks Artists="{Binding Track.Artists}" Style="{StaticResource Subtle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding AlbumTitle}" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0" />
                <Button x:Name="like" Grid.Column="3" Style="{StaticResource ToggleIconButton}" Opacity="0" p:LikePop.Enabled="True"
                        Tag="{Binding IsLiked, Converter={x:Static sh:BoolToOnConverter.Instance}}" Click="Like_Click" ToolTip="Save to Liked songs">
                    <p:Icon Size="18" Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static sh:OnOffIconConverter.Instance}, ConverterParameter=IcoHeart|IcoHeartOutline}" />
                </Button>
                <TextBlock Grid.Column="4" Text="{Binding DurationText}" Style="{StaticResource Subtle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <Button x:Name="more" Grid.Column="5" Style="{StaticResource IconButton}" Opacity="0" Click="More_Click" ToolTip="More options">
                    <p:Icon Data="{StaticResource IcoMore}" />
                </Button>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                <Setter TargetName="row" Property="Background" Value="#2A2A2A" />
                <Setter TargetName="more" Property="Opacity" Value="1" />
                <Setter TargetName="like" Property="Opacity" Value="1" />
            </Trigger>
            <DataTrigger Binding="{Binding IsLiked}" Value="True">
                <Setter TargetName="like" Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                <Setter TargetName="dlBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDownloadPending}" Value="True">
                <Setter TargetName="dlBadge" Property="Visibility" Value="Visible" />
                <Setter TargetName="dlBadge" Property="Background" Value="{DynamicResource TrackBrush}" />
                <Setter TargetName="dlGlyph" Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                <Setter TargetName="row" Property="Opacity" Value="0.4" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                <Setter TargetName="num" Property="Text" Value="&#xE995;" />
                <Setter TargetName="num" Property="FontFamily" Value="{StaticResource IconFont}" />
            </DataTrigger>
            <!-- selecting songs: an empty circle on each row, a filled check when chosen -->
            <DataTrigger Binding="{Binding DataContext.IsSelecting, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                <Setter TargetName="num" Property="Text" Value="&#xEA3A;" />
                <Setter TargetName="num" Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter TargetName="num" Property="FontSize" Value="18" />
                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter TargetName="num" Property="Text" Value="&#xEC61;" />
                <Setter TargetName="num" Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter TargetName="num" Property="FontSize" Value="18" />
                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="TrackList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemTemplate" Value="{StaticResource TrackRowTemplate}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Home ================= -->
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,24,120">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <!-- refresh Home (F5): picks up what you've just been playing; spins while loading -->
                    <Button x:Name="refresh" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh (F5)"
                            VerticalAlignment="Center" Width="40" Height="40" RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <RotateTransform />
                        </Button.RenderTransform>
                        <p:Icon Data="{StaticResource IcoRefresh}" Size="22" />
                    </Button>
                    <!-- shrinks to fit a long name; never wraps -->
                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding GreetingLine}" Style="{StaticResource Title1}" />
                    </Viewbox>
                </DockPanel>
                <!-- offline: Home becomes your downloads -->
                <StackPanel Visibility="{Binding Offline, Converter={StaticResource BoolToVis}}" Margin="0,20,0,0">
                    <Border Style="{DynamicResource SettingGroup}" Padding="20,16" Margin="0,0,0,8">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource TrackBrush}" Margin="0,0,16,0">
                                <TextBlock Text="&#xF384;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{DynamicResource SegmentPill}" Content="Try again" Command="{Binding LoadCommand}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="You're offline" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="{Binding OfflineSummary}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,16,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <StackPanel Visibility="{Binding HasOfflineTracks, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                            <Button Style="{StaticResource AccentPlayButton}" Content="&#xE768;" Foreground="{DynamicResource OnAccentBrush}" Width="56" Height="56" FontSize="20"
                                    Command="{Binding PlayOfflineCommand}" ToolTip="Play your downloads" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="24" Width="48" Height="48" Margin="16,0,0,0"
                                    Command="{Binding ShuffleOfflineCommand}" ToolTip="Shuffle your downloads" />
                            <TextBlock Text="Your downloads" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding OfflineTracks}" ItemTemplate="{StaticResource TrackRowTemplate}" Margin="-12,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <p:TuneLoader Width="44" Height="34" HorizontalAlignment="Left" Margin="4,32,0,0" ToolTip="Loading your music…"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Shelves}" Visibility="{Binding Offline, Converter={x:Static sh:InverseBoolToVisConverter.Instance}}">
                    <ItemsControl.ItemTemplateSelector>
                        <sh:FirstItemTemplateSelector First="{StaticResource FeaturedShelfTemplate}" Rest="{StaticResource ShelfTemplate}" List="{StaticResource QuickPicksShelfTemplate}"
                                                      SpeedDial="{StaticResource SpeedDialShelfTemplate}" />
                    </ItemsControl.ItemTemplateSelector>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
            <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="spin">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="refresh" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="spin" />
                </DataTrigger.ExitActions>
                <Setter TargetName="refresh" Property="IsEnabled" Value="False" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= Moods & genres tile: colour-washed card, the mood's playlist cover tilted in the corner ================= -->
    <DataTemplate x:Key="MoodTileTemplate" DataType="{x:Type vm:MoodTileViewModel}">
        <Button x:Name="tile" Command="{Binding OpenCommand}" Cursor="Hand" Focusable="False" Margin="0,0,14,14" Height="112"
                RenderTransformOrigin="0.5,0.5" ToolTip="{Binding Title}">
            <Button.RenderTransform>
                <TranslateTransform />
            </Button.RenderTransform>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Button.Template>
            <Grid p:RoundClip.Radius="14" Background="{Binding Tint}">
                <Border x:Name="hover" Background="#14FFFFFF" Opacity="0" />
                <!-- the cover, tilted and running off the corner -->
                <Grid x:Name="coverBox" Width="86" Height="86" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-12,-14" RenderTransformOrigin="0.5,0.5"
                        Visibility="{Binding Cover, Converter={StaticResource NullToVis}}">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="20" />
                            <ScaleTransform />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <p:ShadowBox Blur="16" CornerRadius="8" Margin="-16,-14,-16,-18" Opacity="0.5" />
                    <Border CornerRadius="8" Background="#30FFFFFF">
                        <Image Stretch="UniformToFill" p:Art.Url="{Binding Cover}" p:RoundClip.Radius="8" />
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="Bold" FontSize="16" Foreground="White"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" Margin="16,14,84,0" VerticalAlignment="Top" />
                <Border Width="26" Height="4" CornerRadius="2" Background="{Binding Stripe}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,16" />
            </Grid>
        </Button>
        <DataTemplate.Triggers>
            <Trigger SourceName="tile" Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="tile" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-3" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="coverBox" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)" To="10" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="coverBox" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetName="coverBox" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="tile" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="coverBox" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)" To="20" Duration="0:0:0.25" />
                            <DoubleAnimation Storyboard.TargetName="coverBox" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.25" />
                            <DoubleAnimation Storyboard.TargetName="coverBox" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.25" />
                            <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- a titled grid of mood tiles; as many columns as fit -->
    <DataTemplate x:Key="MoodSectionTemplate" DataType="{x:Type vm:MoodSectionViewModel}">
        <StackPanel Margin="0,8,0,10">
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
            <ItemsControl x:Name="grid" ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource MoodTileTemplate}" Margin="0,4,-14,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={x:Static p:ColumnsConverter.Instance}, ConverterParameter=230}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- ================= One mood / genre ================= -->
    <DataTemplate DataType="{x:Type vm:MoodViewModel}">
        <Grid>
            <!-- the mood's colour glows behind the title -->
            <Border Height="300" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0.28" Margin="0,-48,0,0" Background="{Binding Accent}">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,24,120">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Title1}" Margin="0,0,0,16" />
                    <p:TuneLoader Width="44" Height="34" HorizontalAlignment="Left" Margin="4,16,0,0"
                                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Subtle}" FontSize="15"
                               Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />
                    <ItemsControl ItemsSource="{Binding Shelves}" ItemTemplate="{StaticResource ShelfTemplate}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

    <!-- ================= Search ================= -->
    <DataTemplate DataType="{x:Type vm:SearchViewModel}">
        <DockPanel Margin="32,0,24,0">
            <TextBlock DockPanel.Dock="Top" Text="Search" Style="{StaticResource Title1}" Margin="0,0,0,16" />
            <Grid DockPanel.Dock="Top" MaxWidth="560" HorizontalAlignment="Left" Width="560">
                <TextBox x:Name="box" Style="{StaticResource SearchBox}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         Loaded="SearchBox_Loaded">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchNowCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="16"
                           VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                <StackPanel Margin="0,0,0,120">
                    <!-- nothing typed yet: browse moods & genres -->
                    <ItemsControl ItemsSource="{Binding Browse}" ItemTemplate="{StaticResource MoodSectionTemplate}" Margin="0,6,0,0"
                                  Visibility="{Binding ShowBrowse, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Subtle}" FontSize="15" Margin="0,24,0,0"
                               Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />
                    <StackPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Songs" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" />
                        <ItemsControl ItemsSource="{Binding Songs}" ItemTemplate="{StaticResource TrackRowTemplate}" Tag="search" />
                        <ContentControl Content="{Binding}" Focusable="False">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <ContentControl Content="{Binding Artists}" Focusable="False" Tag="Artists" ContentTemplate="{DynamicResource CardRowTemplate}" />
                                        <ContentControl Content="{Binding Albums}" Focusable="False" Tag="Albums" ContentTemplate="{DynamicResource CardRowTemplate}" />
                                        <ContentControl Content="{Binding Playlists}" Focusable="False" Tag="Playlists" ContentTemplate="{DynamicResource CardRowTemplate}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- a titled row of cards; the title comes from the host ContentControl's Tag -->
    <DataTemplate x:Key="CardRowTemplate">
        <StackPanel x:Name="panel">
            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Style="{StaticResource SectionTitle}" />
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Padding="14,14,14,20" Margin="-14,-14,-14,-12">
                <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource CardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Count}" Value="0">
                <Setter TargetName="panel" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= Album / playlist / liked ================= -->
    <DataTemplate DataType="{x:Type vm:CollectionViewModel}">
        <DockPanel>
            <!-- header -->
            <Grid DockPanel.Dock="Top" Margin="32,0,24,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="200" Height="200" CornerRadius="6" Background="#282828" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" />
                        </Border.Effect>
                        <Grid>
                            <TextBlock x:Name="placeholderGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="64" Foreground="#555"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Width="200" Height="200" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="24,0,0,0" MaxWidth="700">
                        <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        <Grid>
                            <TextBlock x:Name="titleText" Text="{Binding Title}" Style="{StaticResource Title1}" FontSize="46" FontWeight="Black"
                                       Margin="0,6,0,10" MouseLeftButtonUp="Title_Click" />
                            <TextBox x:Name="renameBox" Text="{Binding Title, Mode=OneWay}" FontSize="36" FontWeight="Bold" Margin="0,6,0,10"
                                     Background="#333" Foreground="White" CaretBrush="White" BorderThickness="0" Padding="8,2"
                                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                     IsVisibleChanged="RenameBox_IsVisibleChanged" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus" />
                        </Grid>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" FontSize="14"
                                   Visibility="{Binding HasArtists, Converter={x:Static sh:InverseBoolToVisConverter.Instance}}" />
                        <!-- albums: who made it (clickable) • Album • 2023 • 12 songs • 48 min -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasArtists, Converter={StaticResource BoolToVis}}">
                            <p:ArtistLinks Artists="{Binding Artists}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding AlbumFacts, StringFormat='  •  {0}'}" Style="{StaticResource Subtle}" FontSize="14" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <!-- selecting songs: what to do with them -->
            <Border DockPanel.Dock="Top" Margin="32,24,24,12" Height="56" CornerRadius="28" Background="{DynamicResource CardBrush}" Padding="20,0,10,0"
                    Visibility="{Binding IsSelecting, Converter={StaticResource BoolToVis}}">
                <DockPanel VerticalAlignment="Center">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource HeaderPill}" Content="Done" Command="{Binding ToggleSelectingCommand}" Margin="6,0,0,0" />
                    <Button DockPanel.Dock="Right" Style="{DynamicResource HeaderPill}" Content="Select all" Command="{Binding SelectAllCommand}" Margin="6,0,0,0" />
                    <TextBlock Text="{Binding SelectedText}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Width="40" Height="40" ToolTip="Play these" Command="{Binding PlaySelectedCommand}">
                            <p:Icon Data="{StaticResource IcoPlay}" Size="20" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="40" Height="40" ToolTip="Play next" Command="{Binding PlaySelectedNextCommand}">
                            <p:Icon Data="{StaticResource IcoPlayNext}" Size="20" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="40" Height="40" ToolTip="Add to playlist" Click="AddSelected_Click">
                            <p:Icon Data="{StaticResource IcoPlaylistAdd}" Size="20" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="40" Height="40" ToolTip="Download" Command="{Binding DownloadSelectedCommand}">
                            <p:Icon Data="{StaticResource IcoDownload}" Size="20" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="40" Height="40" ToolTip="Remove downloads" Command="{Binding RemoveSelectedDownloadsCommand}"
                                Visibility="{Binding AnySelectedDownloaded, Converter={StaticResource BoolToVis}}">
                            <p:Icon Data="{StaticResource IcoDownloadDone}" Size="20" Foreground="{DynamicResource AccentBrush}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="40" Height="40" ToolTip="{Binding RemoveSelectedText}" Command="{Binding RemoveSelectedCommand}"
                                Visibility="{Binding CanRemoveSelected, Converter={StaticResource BoolToVis}}">
                            <p:Icon Data="{StaticResource IcoDelete}" Size="20" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="40" Height="40" ToolTip="Not interested" Command="{Binding NotInterestedSelectedCommand}">
                            <p:Icon Data="{StaticResource IcoBlock}" Size="20" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="32,24,24,12"
                        Visibility="{Binding IsSelecting, Converter={x:Static sh:InverseBoolToVisConverter.Instance}}">
                <Button Style="{StaticResource AccentPlayButton}" Content="&#xE768;" Foreground="{DynamicResource OnAccentBrush}" Width="56" Height="56" FontSize="20"
                        Command="{Binding PlayCommand}" ToolTip="Play" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="24" Width="48" Height="48" Margin="16,0,0,0"
                        Command="{Binding ShufflePlayCommand}" ToolTip="Shuffle play" />
                <Button Style="{StaticResource ToggleIconButton}" Width="48" Height="48" Margin="8,0,0,0" Command="{Binding ToggleSaveCommand}"
                        Tag="{Binding IsSaved, Converter={x:Static sh:BoolToOnConverter.Instance}}" AutomationProperties.Name="Save album"
                        Visibility="{Binding IsAlbum, Converter={StaticResource BoolToVis}}" ToolTip="Save to Your Library">
                    <p:Icon Size="24" Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static sh:OnOffIconConverter.Instance}, ConverterParameter=IcoLibraryAdded|IcoLibraryAdd}" />
                </Button>
                <Button Style="{StaticResource ToggleIconButton}" Content="&#xE896;" FontSize="22" Width="48" Height="48" Margin="8,0,0,0"
                        Command="{Binding ToggleDownloadAllCommand}" ToolTip="{Binding DownloadAllTip}"
                        Tag="{Binding AllDownloaded, Converter={x:Static sh:BoolToOnConverter.Instance}}"
                        Visibility="{Binding CanDownloadAll, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Download all" />
                <Button x:Name="playlistMenu" Style="{StaticResource IconButton}" Content="&#xE712;" FontSize="22" Width="48" Height="48" Margin="8,0,0,0"
                        Click="PlaylistMenu_Click" ToolTip="More options" />
                <Button Style="{StaticResource IconButton}" Content="&#xE762;" FontSize="20" Width="48" Height="48" Margin="8,0,0,0"
                        Command="{Binding ToggleSelectingCommand}" ToolTip="Select songs (or Ctrl+click / Shift+click)" AutomationProperties.Name="Select songs" />
            </StackPanel>
            <!-- how far along this page's downloads are -->
            <StackPanel DockPanel.Dock="Top" Margin="36,0,40,10" Visibility="{Binding DownloadSummary, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding DownloadSummary}" Style="{StaticResource Subtle}" />
                <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="1" Value="{Binding DownloadFraction, Mode=OneWay}" MaxWidth="520" HorizontalAlignment="Left" Width="520"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}" BorderThickness="0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Style="{StaticResource Subtle}" FontSize="15" Margin="44,12,0,0"
                       Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />
            <ListBox x:Name="tracks" ItemsSource="{Binding Tracks}" Style="{StaticResource TrackList}" Margin="20,0,12,0" Padding="0,0,0,110"
                     AllowDrop="{Binding IsLocal}" PreviewMouseLeftButtonDown="Tracks_PreviewMouseDown" PreviewMouseMove="Tracks_PreviewMouseMove"
                     Drop="Tracks_Drop" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsHistory}" Value="True">
                <Setter TargetName="placeholderGlyph" Property="Text" Value="&#xE81C;" />
                <Setter TargetName="placeholderGlyph" Property="Foreground" Value="White" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDownloads}" Value="True">
                <Setter TargetName="placeholderGlyph" Property="Text" Value="&#xE896;" />
                <Setter TargetName="placeholderGlyph" Property="Foreground" Value="White" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLiked}" Value="True">
                <Setter TargetName="placeholderGlyph" Property="Text" Value="&#xEB52;" />
                <Setter TargetName="placeholderGlyph" Property="Foreground" Value="White" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= Artist ================= -->
    <DataTemplate DataType="{x:Type vm:ArtistViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,24,120">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="200" Height="200">
                        <p:ShadowBox Blur="30" CornerRadius="100" Margin="-30,-24,-30,-36" Opacity="0.55" />
                        <Border CornerRadius="100" Background="#282828" ClipToBounds="True">
                            <Image Width="200" Height="200" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}">
                                <Image.Clip>
                                    <EllipseGeometry Center="100,100" RadiusX="100" RadiusY="100" />
                                </Image.Clip>
                            </Image>
                        </Border>
                    </Grid>
                    <StackPanel VerticalAlignment="Bottom" Margin="24,0,0,0">
                        <TextBlock Text="Artist" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Title1}" FontSize="52" FontWeight="Black" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Stats}" Style="{StaticResource Subtle}" FontSize="14" Margin="0,8,0,0"
                                   Visibility="{Binding Stats, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button Style="{StaticResource AccentPlayButton}" Content="&#xE768;" Foreground="{DynamicResource OnAccentBrush}" Width="56" Height="56" FontSize="20"
                            Command="{Binding PlayCommand}" ToolTip="Play top songs" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="24" Width="48" Height="48" Margin="16,0,0,0"
                            Command="{Binding ShufflePlayCommand}" ToolTip="Shuffle" />
                    <Button Style="{StaticResource IconButton}" Width="48" Height="48" Margin="4,0,0,0" Command="{Binding RadioCommand}" ToolTip="Start radio">
                        <p:Icon Data="{StaticResource IcoRadio}" Size="24" />
                    </Button>
                    <Button Style="{StaticResource OutlinePill}" Content="{Binding FollowText}" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="104"
                            Command="{Binding ToggleFollowCommand}" AutomationProperties.Name="Follow"
                            Tag="{Binding IsFollowing, Converter={x:Static sh:BoolToOnConverter.Instance}}" />
                </StackPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Subtle}" Margin="0,16,0,0" Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ShowAllLink}" Content="Show all" VerticalAlignment="Bottom" Margin="0,0,10,12"
                            Command="{Binding ShowAllSongsCommand}" AutomationProperties.Name="Show all songs"
                            Visibility="{Binding AllSongs, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="Popular" Style="{StaticResource SectionTitle}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding TopSongs}" ItemTemplate="{StaticResource TrackRowTemplate}" Tag="artist" />
                <ItemsControl ItemsSource="{Binding Shelves}" ItemTemplate="{StaticResource ShelfTemplate}" />
                <!-- About -->
                <StackPanel Visibility="{Binding About, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                    <Border CornerRadius="18" Background="{DynamicResource CardBrush}" Padding="24,20" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding About}" Style="{StaticResource Body}" TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource SubtleTextBrush}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ================= "Show all": an artist's albums / singles as a grid ================= -->
    <DataTemplate DataType="{x:Type vm:GridViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,12,120">
            <StackPanel>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Body}" FontWeight="SemiBold" Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource Title1}" FontSize="40" FontWeight="Black" Margin="0,4,0,18" />
                <p:TuneLoader Width="44" Height="34" HorizontalAlignment="Left" Margin="4,16,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource Subtle}" Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CardTemplate}" Margin="-12,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,0,18" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ================= Settings ================= -->
    <Style x:Key="SettingCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="SettingsSection" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
        <Setter Property="Margin" Value="4,26,0,10" />
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="track" Width="44" Height="24" CornerRadius="12" Background="#4D4D4D">
                        <Ellipse x:Name="knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="knob" Property="Width" Value="20" />
                            <Setter TargetName="knob" Property="Height" Value="20" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- one switch row: title, description, switch -->
    <DataTemplate x:Key="SettingText">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,48,0" />
        </StackPanel>
    </DataTemplate>


    <!-- segmented pill button: highlighted when its Tag equals the bound selection -->
    <Style x:Key="SegmentPill" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="18" Padding="18,9" Background="#2A2A2A">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#3A3A3A" />
                        </Trigger>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{x:Static sh:SameConverter.Instance}">
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="DataContext.WidgetStyleName" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <BooleanToVisibilityConverter x:Key="SettingsBoolVis" />
    <Style x:Key="SettingGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20,4" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="SettingRow" TargetType="DockPanel">
        <Setter Property="Margin" Value="0,16" />
        <Setter Property="LastChildFill" Value="True" />
    </Style>
    <Style x:Key="SettingDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Margin" Value="58,0,0,0" />
    </Style>
    <Style x:Key="SettingIconTile" TargetType="Border">
        <Setter Property="DockPanel.Dock" Value="Left" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Margin" Value="0,0,18,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="SettingGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ColorThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="22" Height="22" Background="Transparent">
                        <Ellipse Fill="#40000000" Margin="-1,1,-1,-1" />
                        <Ellipse Stroke="White" StrokeThickness="3" Fill="{DynamicResource AccentBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ColorSlider" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24">
                        <Border Height="12" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="#26FFFFFF" BorderThickness="1" Margin="2,0" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Background="Transparent" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Background="Transparent" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ColorThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HexBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="96" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="#1AFFFFFF" CornerRadius="10" Padding="8,6" BorderThickness="1" BorderBrush="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeaderPill" TargetType="Button" BasedOn="{StaticResource SegmentPill}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="18" Padding="18,9" Background="#2A2A2A">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#3A3A3A" />
                        </Trigger>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{x:Static sh:SameConverter.Instance}">
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="DataContext.HeaderName" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CountPill" TargetType="Button" BasedOn="{StaticResource SegmentPill}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="18" Padding="16,7" Background="#2A2A2A">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#3A3A3A" />
                        </Trigger>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{x:Static sh:SameConverter.Instance}">
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="DataContext.SmartCountName" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- settings category in the left rail; highlighted when it's the one shown -->
    <Style x:Key="SettingsCategory" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="b" CornerRadius="12" Background="Transparent" Padding="14,10">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="bar" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#0FFFFFFF" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{x:Static sh:SameConverter.Instance}">
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="DataContext.Category" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="b" Property="Background" Value="#18FFFFFF" />
                            <Setter TargetName="bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,24,120">
            <StackPanel MaxWidth="1060" HorizontalAlignment="Stretch">
                <!-- you: the account on top (Continue with Google / synced status), settings below -->
                <Border CornerRadius="22" Background="{DynamicResource CardBrush}" Padding="24,22" Margin="0,8,0,0">
                    <DockPanel>
                        <Grid Width="76" Height="76" DockPanel.Dock="Left">
                            <Ellipse Fill="#14FFFFFF" />
                            <p:Icon Data="{StaticResource IcoPerson}" Foreground="{DynamicResource SubtleTextBrush}" Size="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Shell.IsSignedIn, Converter={x:Static sh:InverseBoolToVisConverter.Instance}}" />
                            <Grid Visibility="{Binding Shell.IsSignedIn, Converter={StaticResource BoolToVis}}">
                                <Ellipse Fill="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding Shell.AccountInitial}" Foreground="{DynamicResource OnAccentBrush}" FontSize="32" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Visibility="{Binding Shell.AccountPhoto, Converter={StaticResource NullToVis}}">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Shell.AccountPhoto, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                        </Grid>
                        <!-- signed in: sync now / sign out -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding Shell.IsSignedIn, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Auto sync" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Shell.AutoSync}" VerticalAlignment="Center" Margin="0,0,18,0"
                                      AutomationProperties.Name="Auto sync" ToolTip="Off: syncs only when you click Sync now" />
                            <Button Content="Sync now" Command="{Binding Shell.SyncNowCommand}" Margin="0,0,10,0" AutomationProperties.Name="Sync now" />
                            <Button Content="Sign out" Command="{Binding Shell.SignOutCommand}" AutomationProperties.Name="Sign out" />
                        </StackPanel>
                        <!-- signed out: continue with Google (Tune bars while the browser step runs) -->
                        <Grid DockPanel.Dock="Right" VerticalAlignment="Center"
                              Visibility="{Binding Shell.IsSignedOut, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource HeaderPill}" Content="Continue with Google" Command="{Binding Shell.SignInCommand}" AutomationProperties.Name="Continue with Google"
                                    Visibility="{Binding Shell.IsSigningIn, Converter={x:Static sh:InverseBoolToVisConverter.Instance}}" />
                            <p:TuneLoader Visibility="{Binding Shell.IsSigningIn, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center" Margin="22,0,16,0">
                            <TextBlock Text="{Binding Shell.AccountTitle}" Style="{StaticResource Title1}" FontSize="26" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Shell.AccountEmail}" Style="{StaticResource Subtle}" Margin="0,4,0,0"
                                       Visibility="{Binding Shell.IsSignedIn, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <p:TuneLoader Width="18" Height="12" Margin="0,0,8,0" Visibility="{Binding Shell.IsSyncing, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Shell.AccountStatus}" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- settings: categories on the left, the chosen one on the right -->
                <Grid Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,20,20,0">
                        <TextBlock Text="Settings" Style="{StaticResource Title1}" FontSize="22" Margin="6,0,0,12" />
                        <Button Style="{StaticResource SettingsCategory}" Tag="appearance" Command="{Binding PickCategoryCommand}" CommandParameter="appearance" AutomationProperties.Name="Appearance settings">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Width="22" /><TextBlock Text="Appearance" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource SettingsCategory}" Tag="home" Command="{Binding PickCategoryCommand}" CommandParameter="home" AutomationProperties.Name="Home settings">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Width="22" /><TextBlock Text="Home" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource SettingsCategory}" Tag="playback" Command="{Binding PickCategoryCommand}" CommandParameter="playback" AutomationProperties.Name="Playback settings">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Width="22" /><TextBlock Text="Playback" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource SettingsCategory}" Tag="offline" Command="{Binding PickCategoryCommand}" CommandParameter="offline" AutomationProperties.Name="Offline settings">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Width="22" /><TextBlock Text="Offline" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource SettingsCategory}" Tag="library" Command="{Binding PickCategoryCommand}" CommandParameter="library" AutomationProperties.Name="Library settings">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Width="22" /><TextBlock Text="Library" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource SettingsCategory}" Tag="window" Command="{Binding PickCategoryCommand}" CommandParameter="window" AutomationProperties.Name="Window settings">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE737;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Width="22" /><TextBlock Text="Window" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource SettingsCategory}" Tag="about" Command="{Binding PickCategoryCommand}" CommandParameter="about" AutomationProperties.Name="About settings">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Width="22" /><TextBlock Text="About" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <StackPanel Visibility="{Binding Category, Converter={x:Static sh:EqualsToVisConverter.Instance}, ConverterParameter=appearance}">
                            <!-- live preview of the current theme -->
                            <Border CornerRadius="22" Margin="0,18,0,0" Background="{DynamicResource CardBrush}" ClipToBounds="True">
                                <Grid>
                                    <Border Background="{DynamicResource AccentBrush}" Opacity="0.28">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="Black" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="0.85" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                    <DockPanel Margin="26,24">
                                        <Border Width="104" Height="104" CornerRadius="18" Background="{DynamicResource AccentBrush}" DockPanel.Dock="Left">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" />
                                            </Border.Effect>
                                            <Image Source="{x:Static p:AppIcon.Logo}" Width="56" Height="56" />
                                        </Border>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentPlayButton}" Content="&#xE768;" Foreground="{DynamicResource OnAccentBrush}"
                                                Width="56" Height="56" FontSize="20" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
                                        <StackPanel Margin="24,0,24,0" VerticalAlignment="Center">
                                            <TextBlock Text="YOUR THEME" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Style="{StaticResource Title1}" FontSize="30" Margin="0,4,0,0">
                                                <Run Text="{Binding Accent.Name, Mode=OneWay}" /><Run Text=" on " Foreground="{DynamicResource SubtleTextBrush}" /><Run Text="{Binding Background, Mode=OneWay}" />
                                            </TextBlock>
                                            <Grid Margin="0,16,0,0" Height="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="3*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="2" Background="{DynamicResource TrackBrush}" CornerRadius="2" />
                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                                            </Grid>
                                            <TextBlock Text="Changes apply instantly across Tune and the mini-player." Style="{StaticResource Subtle}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="APPEARANCE" Style="{StaticResource SettingsSection}" />
                            <Border Style="{StaticResource SettingGroup}">
                                <StackPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <Border Style="{StaticResource SettingIconTile}"><TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE790;" /></Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Accent colour" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                        <TextBlock Text="Buttons, progress, the playing song and switches. Pick a preset or any colour you like." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,24,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <ItemsControl ItemsSource="{Binding Accents}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
