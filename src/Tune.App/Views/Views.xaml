<ResourceDictionary x:Class="Tune.App.Views.Views"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Tune.App.ViewModels"
                    xmlns:m="clr-namespace:Tune.Core.Models;assembly=Tune.Core"
                    xmlns:p="clr-namespace:Tune.App.Platform"
                    xmlns:sh="clr-namespace:Tune.App.Shell">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <sh:NullToVisibilityConverter x:Key="NullToVis" />

    <!-- ================= song details pop-up (hover) ================= -->
    <DataTemplate x:Key="SongDetails" DataType="{x:Type m:Track}">
        <StackPanel Orientation="Horizontal" Margin="2">
            <Border Width="96" Height="96" CornerRadius="8" Background="#282828" ClipToBounds="True">
                <Image Width="96" Height="96" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}" />
            </Border>
            <StackPanel Margin="14,2,6,0" MaxWidth="260" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" TextTrimming="None" />
                <TextBlock Text="{Binding ArtistLine}" Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Album.Title, StringFormat=Album · {0}}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Visibility="{Binding Album, Converter={StaticResource NullToVis}}" />
                <TextBlock Text="{Binding Duration, Converter={x:Static sh:DurationConverter.Instance}}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
    <Style x:Key="DetailsTip" TargetType="ToolTip">
        <Setter Property="Background" Value="#F0202020" />
        <Setter Property="BorderBrush" Value="#30FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Placement" Value="Right" />
        <Setter Property="HorizontalOffset" Value="8" />
        <Setter Property="ContentTemplate" Value="{StaticResource SongDetails}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}" Margin="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.55" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- small round overlay buttons on card art (like / more) -->
    <Style x:Key="CardOverlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#B0000000" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="On">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= card (album / playlist / artist / song) ================= -->
    <DataTemplate x:Key="CardTemplate" DataType="{x:Type m:Card}">
        <Button x:Name="card" Width="196" Margin="0,0,12,0" Cursor="Hand" Focusable="False" MouseEnter="Card_MouseEnter" RenderTransformOrigin="0.5,0.5"
                MouseRightButtonUp="Card_RightClick"
                Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="14" Padding="12">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-6" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel>
                <Grid Width="172" Height="172">
                    <Grid.ToolTip>
                        <ToolTip Style="{StaticResource DetailsTip}" Content="{Binding Track}"
                                 Visibility="{Binding Track, Converter={StaticResource NullToVis}}" />
                    </Grid.ToolTip>
                    <Border x:Name="artBorder" CornerRadius="12" Background="#282828" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.4" />
                        </Border.Effect>
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="40" Foreground="#555"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="art" Width="172" Height="172" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,172,172" RadiusX="12" RadiusY="12" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="quick" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                Visibility="{Binding Track, Converter={StaticResource NullToVis}}">
                        <Button x:Name="cardLike" Style="{StaticResource CardOverlayButton}" ToolTip="Save to Liked songs" Click="CardLike_Click" Margin="0,0,6,0" Opacity="0"
                                p:LikePop.Enabled="True">
                            <Button.Tag>
                                <MultiBinding Converter="{x:Static sh:LikedTagConverter.Instance}">
                                    <Binding Path="Track.VideoId" />
                                    <Binding Path="DataContext.LikesVersion" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </Button.Tag>
                            <p:Icon Size="16" Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static sh:OnOffIconConverter.Instance}, ConverterParameter=IcoHeart|IcoHeartOutline}" />
                        </Button>
                        <Button x:Name="cardMore" Style="{StaticResource CardOverlayButton}" ToolTip="More options" Click="CardMore_Click" Opacity="0">
                            <p:Icon Size="16" Data="{StaticResource IcoMore}" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="play" Style="{StaticResource AccentPlayButton}" Content="&#xE768;" Foreground="{DynamicResource OnAccentBrush}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Opacity="0"
                            ToolTip="Play"
                            Command="{Binding DataContext.PlayCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Grid>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,12,0,4" ToolTip="{Binding Title}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Button>
        <DataTemplate.Triggers>
            <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                <Setter TargetName="play" Property="Opacity" Value="1" />
                <Setter TargetName="cardLike" Property="Opacity" Value="1" />
                <Setter TargetName="cardMore" Property="Opacity" Value="1" />
            </Trigger>
            <!-- a liked song keeps its heart showing -->
            <Trigger SourceName="cardLike" Property="Tag" Value="On">
                <Setter TargetName="cardLike" Property="Opacity" Value="1" />
            </Trigger>
            <DataTrigger Binding="{Binding Kind}" Value="Artist">
                <Setter TargetName="artBorder" Property="CornerRadius" Value="86" />
                <Setter TargetName="art" Property="Clip">
                    <Setter.Value>
                        <EllipseGeometry Center="86,86" RadiusX="86" RadiusY="86" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= horizontal shelf with ‹ › scroll buttons ================= -->
    <DataTemplate x:Key="ShelfTemplate" DataType="{x:Type m:Shelf}">
        <StackPanel x:Name="shelf" Background="Transparent">
            <DockPanel>
                <StackPanel x:Name="arrows" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10" Opacity="0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="12" Width="30" Height="30" Background="#1F1F1F" Click="ShelfLeft_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="12" Width="30" Height="30" Background="#1F1F1F" Margin="8,0,0,0" Click="ShelfRight_Click" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False"
                          Padding="14,14,14,20" Margin="-14,-14,-14,-12">
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
        <DataTemplate.Triggers>
            <Trigger SourceName="shelf" Property="IsMouseOver" Value="True">
                <Setter TargetName="arrows" Property="Opacity" Value="1" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= featured card: tall, tinted with the art's own colour ================= -->
    <DataTemplate x:Key="FeaturedCardTemplate" DataType="{x:Type m:Card}">
        <Button x:Name="card" Width="210" Height="292" Margin="0,0,18,0" Cursor="Hand" Focusable="False" RenderTransformOrigin="0.5,0.5"
                MouseEnter="Card_MouseEnter" MouseRightButtonUp="Card_RightClick" AutomationProperties.Name="{Binding Title}"
                Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <Button.RenderTransform>
                <TranslateTransform />
            </Button.RenderTransform>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- shadow lives on its own layer so the text/art never get rasterised (stays sharp) -->
                        <Border x:Name="shadow" CornerRadius="26" Background="Black" Opacity="0.35" Margin="4,8,4,0">
                            <Border.Effect>
                                <BlurEffect Radius="18" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="tint" CornerRadius="26" Background="{DynamicResource CardHoverBrush}" p:Art.TintFrom="{Binding ThumbnailUrl}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="-8" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Grid Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}" FontSize="18" FontWeight="Bold" TextAlignment="Center"
                               TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextBase}" FontSize="12" Foreground="#CCFFFFFF" TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
                <Grid Grid.Row="1" Width="168" Height="168" VerticalAlignment="Bottom">
                    <Border CornerRadius="18" Background="#30000000" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.45" />
                        </Border.Effect>
                        <Image Width="168" Height="168" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,168,168" RadiusX="18" RadiusY="18" />
                            </Image.Clip>
                        </Image>
                    </Border>
                    <Button x:Name="play" Style="{StaticResource AccentPlayButton}" Content="&#xE768;" Foreground="{DynamicResource OnAccentBrush}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Opacity="0" ToolTip="Play"
                            Command="{Binding DataContext.PlayCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Grid>
            </Grid>
        </Button>
        <DataTemplate.Triggers>
            <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                <Setter TargetName="play" Property="Opacity" Value="1" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="FeaturedShelfTemplate" DataType="{x:Type m:Shelf}">
        <StackPanel x:Name="shelf" Background="Transparent">
            <DockPanel>
                <StackPanel x:Name="arrows" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10" Opacity="0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="12" Width="30" Height="30" Background="#1F1F1F" Click="ShelfLeft_Click" ToolTip="Scroll left" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="12" Width="30" Height="30" Background="#1F1F1F" Margin="8,0,0,0" Click="ShelfRight_Click" ToolTip="Scroll right" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False"
                          Padding="16,18,16,26" Margin="-16,-14,-16,-10">
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource FeaturedCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
        <DataTemplate.Triggers>
            <Trigger SourceName="shelf" Property="IsMouseOver" Value="True">
                <Setter TargetName="arrows" Property="Opacity" Value="1" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= one track row ================= -->
    <DataTemplate x:Key="TrackRowTemplate" DataType="{x:Type vm:TrackRowViewModel}">
        <Border x:Name="row" Background="Transparent" CornerRadius="6" Padding="12,6" Height="58" Cursor="Hand"
                MouseLeftButtonUp="TrackRow_Click" MouseRightButtonUp="TrackRow_RightClick" MouseEnter="TrackRow_MouseEnter">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="3*" x:Name="albumCol" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="num" Text="{Binding Number}" Style="{StaticResource Subtle}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="4" Background="#282828" ClipToBounds="True">
                        <Image Width="42" Height="42" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="title" Text="{Binding Title}" Style="{StaticResource Body}">
                            <TextBlock.ToolTip>
                                <ToolTip Style="{StaticResource DetailsTip}" Content="{Binding Track}" />
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <!-- downloaded: accent arrow; waiting/downloading: a dim one -->
                            <Border x:Name="dlBadge" Width="14" Height="14" CornerRadius="7" Background="{DynamicResource AccentBrush}"
                                    Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="{Binding DownloadTip}">
                                <TextBlock x:Name="dlGlyph" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="8" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <p:ArtistLinks Artists="{Binding Track.Artists}" Style="{StaticResource Subtle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding AlbumTitle}" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0" />
                <Button x:Name="like" Grid.Column="3" Style="{StaticResource ToggleIconButton}" Opacity="0" p:LikePop.Enabled="True"
                        Tag="{Binding IsLiked, Converter={x:Static sh:BoolToOnConverter.Instance}}" Click="Like_Click" ToolTip="Save to Liked songs">
                    <p:Icon Size="18" Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static sh:OnOffIconConverter.Instance}, ConverterParameter=IcoHeart|IcoHeartOutline}" />
                </Button>
                <TextBlock Grid.Column="4" Text="{Binding DurationText}" Style="{StaticResource Subtle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <Button x:Name="more" Grid.Column="5" Style="{StaticResource IconButton}" Opacity="0" Click="More_Click" ToolTip="More options">
                    <p:Icon Data="{StaticResource IcoMore}" />
                </Button>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                <Setter TargetName="row" Property="Background" Value="#2A2A2A" />
                <Setter TargetName="more" Property="Opacity" Value="1" />
                <Setter TargetName="like" Property="Opacity" Value="1" />
            </Trigger>
            <DataTrigger Binding="{Binding IsLiked}" Value="True">
                <Setter TargetName="like" Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                <Setter TargetName="dlBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDownloadPending}" Value="True">
                <Setter TargetName="dlBadge" Property="Visibility" Value="Visible" />
                <Setter TargetName="dlBadge" Property="Background" Value="{DynamicResource TrackBrush}" />
                <Setter TargetName="dlGlyph" Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                <Setter TargetName="row" Property="Opacity" Value="0.4" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                <Setter TargetName="num" Property="Text" Value="&#xE995;" />
                <Setter TargetName="num" Property="FontFamily" Value="{StaticResource IconFont}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="TrackList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemTemplate" Value="{StaticResource TrackRowTemplate}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Home ================= -->
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,24,120">
            <StackPanel>
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource Title1}" Margin="0,0,0,4" />
                <!-- offline: Home becomes your downloads -->
                <StackPanel Visibility="{Binding Offline, Converter={StaticResource BoolToVis}}" Margin="0,20,0,0">
                    <Border Style="{DynamicResource SettingGroup}" Padding="20,16" Margin="0,0,0,8">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource TrackBrush}" Margin="0,0,16,0">
                                <TextBlock Text="&#xF384;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{DynamicResource SegmentPill}" Content="Try again" Command="{Binding LoadCommand}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="You're offline" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="{Binding OfflineSummary}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,16,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <StackPanel Visibility="{Binding HasOfflineTracks, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                            <Button Style="{StaticResource AccentPlayButton}" Content="&#xE768;" Foreground="{DynamicResource OnAccentBrush}" Width="56" Height="56" FontSize="20"
                                    Command="{Binding PlayOfflineCommand}" ToolTip="Play your downloads" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="24" Width="48" Height="48" Margin="16,0,0,0"
                                    Command="{Binding ShuffleOfflineCommand}" ToolTip="Shuffle your downloads" />
                            <TextBlock Text="Your downloads" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding OfflineTracks}" ItemTemplate="{StaticResource TrackRowTemplate}" Margin="-12,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Loading your music…" Style="{StaticResource Subtle}" Margin="0,24,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Shelves}" Visibility="{Binding Offline, Converter={x:Static sh:InverseBoolToVisConverter.Instance}}">
                    <ItemsControl.ItemTemplateSelector>
                        <sh:FirstItemTemplateSelector First="{StaticResource FeaturedShelfTemplate}" Rest="{StaticResource ShelfTemplate}" />
                    </ItemsControl.ItemTemplateSelector>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ================= Search ================= -->
    <DataTemplate DataType="{x:Type vm:SearchViewModel}">
        <DockPanel Margin="32,0,24,0">
            <TextBlock DockPanel.Dock="Top" Text="Search" Style="{StaticResource Title1}" Margin="0,0,0,16" />
            <Grid DockPanel.Dock="Top" MaxWidth="560" HorizontalAlignment="Left" Width="560">
                <TextBox x:Name="box" Style="{StaticResource SearchBox}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         Loaded="SearchBox_Loaded">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchNowCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="16"
                           VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                <StackPanel Margin="0,0,0,120">
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Subtle}" FontSize="15" Margin="0,24,0,0"
                               Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />
                    <StackPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Songs" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" />
                        <ItemsControl ItemsSource="{Binding Songs}" ItemTemplate="{StaticResource TrackRowTemplate}" Tag="search" />
                        <ContentControl Content="{Binding}" Focusable="False">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <ContentControl Content="{Binding Artists}" Focusable="False" Tag="Artists" ContentTemplate="{DynamicResource CardRowTemplate}" />
                                        <ContentControl Content="{Binding Albums}" Focusable="False" Tag="Albums" ContentTemplate="{DynamicResource CardRowTemplate}" />
                                        <ContentControl Content="{Binding Playlists}" Focusable="False" Tag="Playlists" ContentTemplate="{DynamicResource CardRowTemplate}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- a titled row of cards; the title comes from the host ContentControl's Tag -->
    <DataTemplate x:Key="CardRowTemplate">
        <StackPanel x:Name="panel">
            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Style="{StaticResource SectionTitle}" />
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Padding="14,14,14,20" Margin="-14,-14,-14,-12">
                <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource CardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Count}" Value="0">
                <Setter TargetName="panel" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= Album / playlist / liked ================= -->
    <DataTemplate DataType="{x:Type vm:CollectionViewModel}">
        <DockPanel>
            <!-- header -->
            <Grid DockPanel.Dock="Top" Margin="32,0,24,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="200" Height="200" CornerRadius="6" Background="#282828" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" />
                        </Border.Effect>
                        <Grid>
                            <TextBlock x:Name="placeholderGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="64" Foreground="#555"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Width="200" Height="200" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="24,0,0,0" MaxWidth="700">
                        <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        <Grid>
                            <TextBlock x:Name="titleText" Text="{Binding Title}" Style="{StaticResource Title1}" FontSize="46" FontWeight="Black"
                                       Margin="0,6,0,10" MouseLeftButtonUp="Title_Click" />
                            <TextBox x:Name="renameBox" Text="{Binding Title, Mode=OneWay}" FontSize="36" FontWeight="Bold" Margin="0,6,0,10"
                                     Background="#333" Foreground="White" CaretBrush="White" BorderThickness="0" Padding="8,2"
                                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                     IsVisibleChanged="RenameBox_IsVisibleChanged" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus" />
                        </Grid>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" FontSize="14" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="32,24,24,12">
                <Button Style="{StaticResource AccentPlayButton}" Content="&#xE768;" Foreground="{DynamicResource OnAccentBrush}" Width="56" Height="56" FontSize="20"
                        Command="{Binding PlayCommand}" ToolTip="Play" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="24" Width="48" Height="48" Margin="16,0,0,0"
                        Command="{Binding ShufflePlayCommand}" ToolTip="Shuffle play" />
                <Button Style="{StaticResource ToggleIconButton}" Content="&#xE896;" FontSize="22" Width="48" Height="48" Margin="8,0,0,0"
                        Command="{Binding ToggleDownloadAllCommand}" ToolTip="{Binding DownloadAllTip}"
                        Tag="{Binding AllDownloaded, Converter={x:Static sh:BoolToOnConverter.Instance}}"
                        Visibility="{Binding CanDownloadAll, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Download all" />
                <Button x:Name="playlistMenu" Style="{StaticResource IconButton}" Content="&#xE712;" FontSize="22" Width="48" Height="48" Margin="8,0,0,0"
                        Click="PlaylistMenu_Click" ToolTip="More options" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Style="{StaticResource Subtle}" FontSize="15" Margin="44,12,0,0"
                       Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />
            <ListBox x:Name="tracks" ItemsSource="{Binding Tracks}" Style="{StaticResource TrackList}" Margin="20,0,12,0" Padding="0,0,0,110"
                     AllowDrop="{Binding IsLocal}" PreviewMouseLeftButtonDown="Tracks_PreviewMouseDown" PreviewMouseMove="Tracks_PreviewMouseMove"
                     Drop="Tracks_Drop" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDownloads}" Value="True">
                <Setter TargetName="placeholderGlyph" Property="Text" Value="&#xE896;" />
                <Setter TargetName="placeholderGlyph" Property="Foreground" Value="White" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLiked}" Value="True">
                <Setter TargetName="placeholderGlyph" Property="Text" Value="&#xEB52;" />
                <Setter TargetName="placeholderGlyph" Property="Foreground" Value="White" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= Artist ================= -->
    <DataTemplate DataType="{x:Type vm:ArtistViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,24,120">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="200" Height="200" CornerRadius="100" Background="#282828" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" />
                        </Border.Effect>
                        <Image Width="200" Height="200" Stretch="UniformToFill" p:Art.Url="{Binding ThumbnailUrl}">
                            <Image.Clip>
                                <EllipseGeometry Center="100,100" RadiusX="100" RadiusY="100" />
                            </Image.Clip>
                        </Image>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="24,0,0,0">
                        <TextBlock Text="Artist" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Title1}" FontSize="52" FontWeight="Black" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource AccentPlayButton}" Content="&#xE768;" Foreground="{DynamicResource OnAccentBrush}" Width="56" Height="56" FontSize="20"
                        HorizontalAlignment="Left" Margin="0,24,0,0" Command="{Binding PlayCommand}" ToolTip="Play top songs" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource Subtle}" Margin="0,16,0,0" Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />
                <TextBlock Text="Popular" Style="{StaticResource SectionTitle}" />
                <ItemsControl ItemsSource="{Binding TopSongs}" ItemTemplate="{StaticResource TrackRowTemplate}" Tag="artist" />
                <ItemsControl ItemsSource="{Binding Shelves}" ItemTemplate="{StaticResource ShelfTemplate}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ================= Settings ================= -->
    <Style x:Key="SettingCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="SettingsSection" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
        <Setter Property="Margin" Value="4,26,0,10" />
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="track" Width="44" Height="24" CornerRadius="12" Background="#4D4D4D">
                        <Ellipse x:Name="knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="knob" Property="Width" Value="20" />
                            <Setter TargetName="knob" Property="Height" Value="20" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- one switch row: title, description, switch -->
    <DataTemplate x:Key="SettingText">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,48,0" />
        </StackPanel>
    </DataTemplate>


    <!-- segmented pill button: highlighted when its Tag equals the bound selection -->
    <Style x:Key="SegmentPill" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="18" Padding="18,9" Background="#2A2A2A">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#3A3A3A" />
                        </Trigger>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{x:Static sh:SameConverter.Instance}">
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="DataContext.WidgetStyleName" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <BooleanToVisibilityConverter x:Key="SettingsBoolVis" />
    <Style x:Key="SettingGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20,4" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="SettingRow" TargetType="DockPanel">
        <Setter Property="Margin" Value="0,16" />
        <Setter Property="LastChildFill" Value="True" />
    </Style>
    <Style x:Key="SettingDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Margin" Value="58,0,0,0" />
    </Style>
    <Style x:Key="SettingIconTile" TargetType="Border">
        <Setter Property="DockPanel.Dock" Value="Left" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Margin" Value="0,0,18,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="SettingGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ColorThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="22" Height="22" Background="Transparent">
                        <Ellipse Fill="#40000000" Margin="-1,1,-1,-1" />
                        <Ellipse Stroke="White" StrokeThickness="3" Fill="{DynamicResource AccentBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ColorSlider" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24">
                        <Border Height="12" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="#26FFFFFF" BorderThickness="1" Margin="2,0" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Background="Transparent" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Background="Transparent" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ColorThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HexBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CaretBrush" Value="White" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="96" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="#1AFFFFFF" CornerRadius="10" Padding="8,6" BorderThickness="1" BorderBrush="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeaderPill" TargetType="Button" BasedOn="{StaticResource SegmentPill}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="18" Padding="18,9" Background="#2A2A2A">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#3A3A3A" />
                        </Trigger>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{x:Static sh:SameConverter.Instance}">
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="DataContext.HeaderName" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,24,120">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left" Width="820">
                <TextBlock Text="Settings" Style="{StaticResource Title1}" />
                <TextBlock Text="Make Tune look and play the way you like." Style="{StaticResource Subtle}" FontSize="14" Margin="0,6,0,0" />
                <!-- live preview of the current theme -->
                <Border CornerRadius="22" Margin="0,18,0,0" Background="{DynamicResource CardBrush}" ClipToBounds="True">
                    <Grid>
                        <Border Background="{DynamicResource AccentBrush}" Opacity="0.28">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="Black" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="0.85" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <DockPanel Margin="26,24">
                            <Border Width="104" Height="104" CornerRadius="18" Background="{DynamicResource AccentBrush}" DockPanel.Dock="Left">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" />
                                </Border.Effect>
                                <Image Source="{x:Static p:AppIcon.Logo}" Width="56" Height="56" />
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentPlayButton}" Content="&#xE768;" Foreground="{DynamicResource OnAccentBrush}"
                                    Width="56" Height="56" FontSize="20" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
                            <StackPanel Margin="24,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="YOUR THEME" Style="{StaticResource SectionLabel}" />
                                <TextBlock Style="{StaticResource Title1}" FontSize="30" Margin="0,4,0,0">
                                    <Run Text="{Binding Accent.Name, Mode=OneWay}" /><Run Text=" on " Foreground="{DynamicResource SubtleTextBrush}" /><Run Text="{Binding Background, Mode=OneWay}" />
                                </TextBlock>
                                <Grid Margin="0,16,0,0" Height="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" Background="{DynamicResource TrackBrush}" CornerRadius="2" />
                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                                </Grid>
                                <TextBlock Text="Changes apply instantly across Tune and the mini-player." Style="{StaticResource Subtle}" Margin="0,10,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <TextBlock Text="APPEARANCE" Style="{StaticResource SettingsSection}" />
                <Border Style="{StaticResource SettingGroup}">
                    <StackPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Border Style="{StaticResource SettingIconTile}"><TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE790;" /></Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Accent colour" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="Buttons, progress, the playing song and switches. Pick a preset or any colour you like." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,24,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <ItemsControl ItemsSource="{Binding Accents}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Cursor="Hand" Focusable="False" Margin="0,0,8,0" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                                    Command="{Binding DataContext.PickAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Width="42" Height="42" Background="Transparent">
                                                            <Ellipse x:Name="ring" Stroke="White" StrokeThickness="2" Opacity="0" />
                                                            <Ellipse x:Name="dot" Margin="5" Fill="{Binding Color, Converter={x:Static sh:ColorToBrushConverter.Instance}}" />
                                                            <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                                       Foreground="{Binding Color, Converter={x:Static sh:OnColorBrushConverter.Instance}}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{x:Static sh:SameConverter.Instance}">
                                                                        <Binding />
                                                                        <Binding Path="DataContext.Accent" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter TargetName="ring" Property="Opacity" Value="1" />
                                                                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ring" Property="Opacity" Value="0.5" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- free colour: rainbow swatch opens the picker -->
                                <Button Cursor="Hand" Focusable="False" ToolTip="Pick any colour" AutomationProperties.Name="Custom colour"
                                        Command="{Binding ToggleCustomCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Width="42" Height="42" Background="Transparent">
                                                <Ellipse x:Name="ring" Stroke="White" StrokeThickness="2" Opacity="0" />
                                                <Ellipse Margin="5">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FF4D4D" Offset="0" />
                                                            <GradientStop Color="#FFD34D" Offset="0.25" />
                                                            <GradientStop Color="#4DFF88" Offset="0.5" />
                                                            <GradientStop Color="#4DA6FF" Offset="0.75" />
                                                            <GradientStop Color="#C04DFF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Ellipse Margin="13" Fill="#CC000000" />
                                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                    <Setter TargetName="ring" Property="Opacity" Value="1" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ring" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- the free colour picker -->
                            <Border Visibility="{Binding ShowPicker, Converter={StaticResource SettingsBoolVis}}" Margin="0,16,0,0"
                                    Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="16" Padding="20,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <Border Width="84" Height="84" CornerRadius="42" Background="{DynamicResource AccentBrush}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="{DynamicResource AccentColor}" />
                                            </Border.Effect>
                                            <TextBlock Text="Aa" FontFamily="{StaticResource UiFont}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBox Style="{StaticResource HexBox}" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" Margin="0,14,0,0"
                                                 AutomationProperties.Name="Hex colour" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Hue" Style="{StaticResource Caption}" />
                                        <Slider Style="{StaticResource ColorSlider}" Minimum="0" Maximum="359.9" Value="{Binding Hue}" AutomationProperties.Name="Hue">
                                            <Slider.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FF0000" Offset="0" />
                                                    <GradientStop Color="#FFFF00" Offset="0.1667" />
                                                    <GradientStop Color="#00FF00" Offset="0.3333" />
                                                    <GradientStop Color="#00FFFF" Offset="0.5" />
                                                    <GradientStop Color="#0000FF" Offset="0.6667" />
                                                    <GradientStop Color="#FF00FF" Offset="0.8333" />
                                                    <GradientStop Color="#FF0000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Slider.Background>
                                        </Slider>
                                        <TextBlock Text="Saturation" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                                        <Slider Style="{StaticResource ColorSlider}" Minimum="0" Maximum="1" Value="{Binding Sat}" Background="{Binding SatTrack}" AutomationProperties.Name="Saturation" />
                                        <TextBlock Text="Brightness" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                                        <Slider Style="{StaticResource ColorSlider}" Minimum="0" Maximum="1" Value="{Binding Val}" Background="{Binding ValTrack}" AutomationProperties.Name="Brightness" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource SettingDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Border Style="{StaticResource SettingIconTile}"><TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE771;" /></Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Background" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="Dark is classic, Black is pure black (great on OLED), Midnight is a deep blue." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,24,0" />
                            <Border Height="16" />
                            <ItemsControl ItemsSource="{Binding Backgrounds}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Cursor="Hand" Focusable="False" Margin="0,0,12,0" AutomationProperties.Name="{Binding}"
                                                Command="{Binding DataContext.PickBackgroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <StackPanel>
                                                        <Border x:Name="tile" Width="128" Height="76" CornerRadius="10" BorderThickness="2" BorderBrush="#3A3A3A" ClipToBounds="True">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="30" />
                                                                    <ColumnDefinition />
                                                                </Grid.ColumnDefinitions>
                                                                <Border x:Name="side" Background="#000" CornerRadius="8,0,0,8" />
                                                                <Border x:Name="main" Grid.Column="1" Background="#121212" CornerRadius="0,8,8,0">
                                                                    <StackPanel Margin="10,12" Orientation="Horizontal">
                                                                        <Border x:Name="card1" Width="22" Height="22" CornerRadius="4" Background="#282828" Margin="0,0,6,0" />
                                                                        <Border x:Name="card2" Width="22" Height="22" CornerRadius="4" Background="#282828" Margin="0,0,6,0" />
                                                                        <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource AccentBrush}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Subtle}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="Black">
                                                            <Setter TargetName="main" Property="Background" Value="#000" />
                                                            <Setter TargetName="card1" Property="Background" Value="#1C1C1C" />
                                                            <Setter TargetName="card2" Property="Background" Value="#1C1C1C" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="Midnight">
                                                            <Setter TargetName="side" Property="Background" Value="#050812" />
                                                            <Setter TargetName="main" Property="Background" Value="#0B1020" />
                                                            <Setter TargetName="card1" Property="Background" Value="#1E2742" />
                                                            <Setter TargetName="card2" Property="Background" Value="#1E2742" />
                                                        </DataTrigger>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{x:Static sh:SameConverter.Instance}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.Background" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="tile" Property="Opacity" Value="0.85" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource SettingDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Border Style="{StaticResource SettingIconTile}"><TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE7F4;" /></Border>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Translucent}" VerticalAlignment="Center" AutomationProperties.Name="Translucent window" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Translucent window" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="Frosted glass that lets your desktop's colours show through (Windows 11)." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,24,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource SettingDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Border Style="{StaticResource SettingIconTile}"><TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE8B9;" /></Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Colour at the top of pages" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="None keeps every page one consistent colour." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,24,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource HeaderPill}" Tag="None" Content="None" AutomationProperties.Name="Header none"
                                        Command="{Binding PickHeaderCommand}" CommandParameter="None" />
                                <Button Style="{StaticResource HeaderPill}" Tag="Accent" Content="Accent colour" AutomationProperties.Name="Header accent"
                                        Command="{Binding PickHeaderCommand}" CommandParameter="Accent" />
                                <Button Style="{StaticResource HeaderPill}" Tag="AlbumArt" Content="Album art" AutomationProperties.Name="Header album art"
                                        Command="{Binding PickHeaderCommand}" CommandParameter="AlbumArt" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="MINI-PLAYER" Style="{StaticResource SettingsSection}" />
                <Border Style="{StaticResource SettingGroup}">
                    <StackPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Border Style="{StaticResource SettingIconTile}"><TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE8A7;" /></Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Mini-player style" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="The floating player you can keep anywhere on screen. Right-click it to switch too." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,24,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource SegmentPill}" Tag="Compact" Content="Compact bar" AutomationProperties.Name="Compact bar"
                                        Command="{Binding PickWidgetStyleCommand}" CommandParameter="Compact" />
                                <Button Style="{StaticResource SegmentPill}" Tag="Card" Content="Card with controls" AutomationProperties.Name="Card with controls"
                                        Command="{Binding PickWidgetStyleCommand}" CommandParameter="Card" />
                                <Button Style="{StaticResource SegmentPill}" Tag="Square" Content="Album art tile" AutomationProperties.Name="Album art tile"
                                        Command="{Binding PickWidgetStyleCommand}" CommandParameter="Square" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource SettingDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Border Style="{StaticResource SettingIconTile}"><TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE718;" /></Border>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding MiniOnTop}" VerticalAlignment="Center" AutomationProperties.Name="Mini-player on top" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Always on top" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="The floating player stays above other windows." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,24,0" />
                        </StackPanel>
                    </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="PLAYBACK" Style="{StaticResource SettingsSection}" />
                <Border Style="{StaticResource SettingGroup}">
                    <StackPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Border Style="{StaticResource SettingIconTile}"><TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE767;" /></Border>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Normalize}" VerticalAlignment="Center" AutomationProperties.Name="Normalize volume" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Normalize volume" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="Quiet and loud songs play at a similar level." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,24,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource SettingDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Border Style="{StaticResource SettingIconTile}"><TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE893;" /></Border>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding SponsorBlock}" VerticalAlignment="Center" AutomationProperties.Name="Skip non-music parts" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Skip non-music parts" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="Skips talking intros, skits and outros in music videos (SponsorBlock). Only a short video code is sent to sponsor.ajay.app." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,24,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource SettingDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Border Style="{StaticResource SettingIconTile}"><TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE8D2;" /></Border>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding SyncedLyrics}" VerticalAlignment="Center" AutomationProperties.Name="Synced lyrics" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Synced lyrics" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="Lyrics follow the song line by line (lrclib.net; the song title and artist are sent). Off: plain YouTube Music lyrics." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,24,0" />
                        </StackPanel>
                    </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="WINDOW &amp; STARTUP" Style="{StaticResource SettingsSection}" />
                <Border Style="{StaticResource SettingGroup}">
                    <StackPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Border Style="{StaticResource SettingIconTile}"><TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE768;" /></Border>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}" VerticalAlignment="Center" AutomationProperties.Name="Keep playing when closed" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Keep playing when closed" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="The close button hides Tune to the tray. Off: the close button quits." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,24,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource SettingDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Border Style="{StaticResource SettingIconTile}"><TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE7E8;" /></Border>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" AutomationProperties.Name="Start with Windows" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="Opens quietly in the tray (with the mini-player) when you sign in." Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,24,0" />
                        </StackPanel>
                    </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="STORAGE &amp; ABOUT" Style="{StaticResource SettingsSection}" />
                <Border Style="{StaticResource SettingGroup}">
                    <StackPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Border Style="{StaticResource SettingIconTile}"><TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE8B7;" /></Border>
                        <Button DockPanel.Dock="Right" Content="Clear" VerticalAlignment="Center" Command="{Binding ClearCacheCommand}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Album art cache" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CacheSize, StringFormat=Using {0} (kept under 200 MB automatically)}" Style="{StaticResource Subtle}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource SettingDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Border Style="{StaticResource SettingIconTile}"><TextBlock Style="{StaticResource SettingGlyph}" Text="&#xE895;" /></Border>
                        <Button DockPanel.Dock="Right" Content="Update now" VerticalAlignment="Center" Command="{Binding UpdateYtDlpCommand}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="YouTube helper" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ResolverStatus}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,3,24,0" />
                            <TextBlock Text="Updates itself. If songs stop playing, update it now." Style="{StaticResource Subtle}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding UpdateResult}" Style="{StaticResource Subtle}" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="4,22,0,0">
                    <Image Source="{x:Static p:AppIcon.Logo}" Width="28" Height="28" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Run Text="Tune" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><Run Text="{Binding Version, Mode=OneWay, StringFormat=' {0}'}" /><Run Text=" · no account, nothing leaves this PC except YouTube requests" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
