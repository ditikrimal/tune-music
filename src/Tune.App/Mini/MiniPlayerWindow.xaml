<Window x:Class="Tune.App.Mini.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Tune.App.Platform"
        Title="Tune mini-player" Width="316" Height="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- 8 px transparent margin leaves room for the drop shadow -->
    <Border x:Name="Card" Margin="8" CornerRadius="12" Background="#EB181818" BorderBrush="#14FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.55" />
        </Border.Effect>
        <Grid Margin="10,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="44" Height="44" CornerRadius="6" Background="#282828" ClipToBounds="True" VerticalAlignment="Center">
                <Grid>
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Width="44" Height="44" Stretch="UniformToFill" p:Art.Url="{Binding ArtUrl}" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, TargetNullValue='Nothing playing', FallbackValue='Nothing playing'}" Style="{StaticResource Body}" FontSize="13" FontWeight="SemiBold" ToolTip="{Binding Title}" />
                <TextBlock Text="{Binding ArtistLine}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,1,0,0" />
                <ProgressBar Height="3" Margin="0,6,0,0" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position, Mode=OneWay}"
                             Foreground="{StaticResource AccentBrush}" Background="#3A3A3A" BorderThickness="0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE892;" Width="28" Height="28" FontSize="13" Command="{Binding PreviousCommand}" ToolTip="Previous" />
                <Button Style="{StaticResource PlayButton}" Content="{Binding PlayGlyph}" Width="30" Height="30" FontSize="12" Margin="2,0" Command="{Binding PlayPauseCommand}" ToolTip="Play/Pause" />
                <Button Style="{StaticResource IconButton}" Content="&#xE893;" Width="28" Height="28" FontSize="13" Command="{Binding NextCommand}" ToolTip="Next" />
            </StackPanel>

            <!-- ⤢ open main / ✕ hide, shown on hover in the top-right corner -->
            <StackPanel x:Name="Corner" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-6,-4,0" Opacity="0">
                <Button Style="{StaticResource IconButton}" Content="&#xE740;" Width="20" Height="20" FontSize="9" Background="#333" Click="Expand_Click" ToolTip="Open Tune" />
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="20" Height="20" FontSize="9" Background="#333" Margin="3,0,0,0" Click="Hide_Click" ToolTip="Hide mini-player" />
            </StackPanel>
        </Grid>
    </Border>
    <Window.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Corner" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Corner" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
