<Window x:Class="Tune.App.Mini.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Tune.App.Platform"
        xmlns:sh="clr-namespace:Tune.App.Shell"
        Title="Tune mini-player" Width="352" Height="96"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseRightButtonUp="Window_MouseRightButtonUp">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- pin: filled while "always on top" is on -->
        <!-- pinned: filled pin on an accent circle; not pinned: faint outline pin -->
        <Style x:Key="PinButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE718;" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#E0303030" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="ToolTip" Value="Keep on top: off" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Content" Value="&#xE841;" />
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                    <Setter Property="ToolTip" Value="Keep on top: on" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WidgetText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource WidgetText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Text" Value="{Binding Title}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasTrack}" Value="False">
                    <Setter Property="Text" Value="Nothing playing" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ArtistText" TargetType="TextBlock" BasedOn="{StaticResource WidgetText}">
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="Text" Value="{Binding ArtistLine}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasTrack}" Value="False">
                    <Setter Property="Text" Value="Pick a song in Tune" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="Text" Value="Loading…" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="ThinProgress" TargetType="ProgressBar">
            <Grid>
                <Border Background="#40FFFFFF" CornerRadius="2" />
                <Border x:Name="PART_Track" />
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{TemplateBinding Foreground}" />
            </Grid>
        </ControlTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Margin="10" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="8" />
        </Grid.RenderTransform>

        <!-- ================= COMPACT: slim album-tinted bar ================= -->
        <Grid x:Name="CompactView">
            <Border CornerRadius="16" Background="#181818">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.6" />
                </Border.Effect>
            </Border>
            <Border CornerRadius="16" Background="{Binding Tint}" />
            <Border CornerRadius="16" BorderBrush="#1FFFFFFF" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#66000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid Margin="12,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="9" Background="#30000000" ClipToBounds="True" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5" />
                    </Border.Effect>
                    <Image Width="52" Height="52" Stretch="UniformToFill" p:Art.Url="{Binding ArtUrl}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TitleText}" FontSize="14" ToolTip="{Binding Title}" />
                    <TextBlock Style="{StaticResource ArtistText}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToggleIconButton}" Content="{Binding LikeGlyph}" Width="30" Height="30" FontSize="14" Foreground="White"
                            Tag="{Binding IsLiked, Converter={x:Static sh:BoolToOnConverter.Instance}}" Command="{Binding ToggleLikeCommand}" ToolTip="Save to Liked songs" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" Width="30" Height="30" FontSize="14" Foreground="White" Command="{Binding PreviousCommand}" ToolTip="Previous" />
                    <Button Style="{StaticResource PlayButton}" Content="{Binding PlayGlyph}" Width="36" Height="36" FontSize="14" Margin="2,0" Command="{Binding PlayPauseCommand}" ToolTip="Play/Pause" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" Width="30" Height="30" FontSize="14" Foreground="White" Command="{Binding NextCommand}" ToolTip="Next" />
                </StackPanel>
            </Grid>
            <ProgressBar Template="{StaticResource ThinProgress}" VerticalAlignment="Bottom" Height="3" Margin="16,0,16,5"
                         Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position, Mode=OneWay}" Foreground="White"
                         Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}" />
            <StackPanel x:Name="CompactCorner" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-6,0" Opacity="0">
                <Button Style="{StaticResource PinButton}" Width="22" Height="22" FontSize="9" Click="Pin_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE740;" Width="22" Height="22" FontSize="9" Foreground="White" Background="#E0303030" Margin="4,0,0,0" Click="Expand_Click" ToolTip="Open Tune" />
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="22" Height="22" FontSize="9" Foreground="White" Background="#E0303030" Margin="4,0,0,0" Click="Hide_Click" ToolTip="Hide mini-player" />
            </StackPanel>
        </Grid>

        <!-- ================= CARD: big art, album-tinted, full controls ================= -->
        <Grid x:Name="CardView" Visibility="Collapsed">
            <Border CornerRadius="22" Background="#181818">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.6" />
                </Border.Effect>
            </Border>
            <Border CornerRadius="22" Background="{Binding Tint}" />
            <Border CornerRadius="22" BorderBrush="#26FFFFFF" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#14FFFFFF" Offset="0" />
                        <GradientStop Color="#40000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid Margin="16,10,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource PinButton}" Width="26" Height="26" FontSize="11" Click="Pin_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE740;" Width="26" Height="26" FontSize="11" Foreground="#CCFFFFFF" Click="Expand_Click" ToolTip="Open Tune" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="26" Height="26" FontSize="11" Foreground="#CCFFFFFF" Click="Hide_Click" ToolTip="Hide mini-player" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{x:Static p:AppIcon.Logo}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Tune" Style="{StaticResource WidgetText}" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="112" Height="112" CornerRadius="14" Background="#30000000" ClipToBounds="True" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" />
                        </Border.Effect>
                        <Image Width="112" Height="112" Stretch="UniformToFill" p:Art.Url="{Binding ArtUrl}" />
                    </Border>
                    <Grid Grid.Column="1" Margin="16,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToggleIconButton}" Content="{Binding LikeGlyph}" Width="32" Height="32" FontSize="16" Foreground="White"
                                    Tag="{Binding IsLiked, Converter={x:Static sh:BoolToOnConverter.Instance}}" Command="{Binding ToggleLikeCommand}" ToolTip="Save to Liked songs" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource TitleText}" FontSize="17" FontWeight="Bold" ToolTip="{Binding Title}" />
                                <TextBlock Style="{StaticResource ArtistText}" FontSize="13" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToggleIconButton}" Content="&#xE8B1;" Width="32" Height="32" FontSize="14" Foreground="#CCFFFFFF" Tag="{Binding ShuffleTag}" Command="{Binding ToggleShuffleCommand}" ToolTip="Shuffle" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" Width="34" Height="34" FontSize="16" Foreground="White" Margin="6,0" Command="{Binding PreviousCommand}" ToolTip="Previous" />
                            <Button Style="{StaticResource PlayButton}" Content="{Binding PlayGlyph}" Width="42" Height="42" FontSize="16" Command="{Binding PlayPauseCommand}" ToolTip="Play/Pause" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" Width="34" Height="34" FontSize="16" Foreground="White" Margin="6,0" Command="{Binding NextCommand}" ToolTip="Next" />
                            <Button Style="{StaticResource ToggleIconButton}" Content="{Binding RepeatGlyph}" Width="32" Height="32" FontSize="14" Foreground="#CCFFFFFF" Tag="{Binding RepeatTag}" Command="{Binding CycleRepeatCommand}" ToolTip="{Binding RepeatTip}" />
                        </StackPanel>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PositionText}" Style="{StaticResource WidgetText}" FontSize="11" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" Template="{StaticResource ThinProgress}" Height="4" Margin="10,0" VerticalAlignment="Center"
                                         Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position, Mode=OneWay}" Foreground="White" />
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource WidgetText}" FontSize="11" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= SQUARE: album-art tile ================= -->
        <Grid x:Name="SquareView" Visibility="Collapsed">
            <Border CornerRadius="24" Background="#181818">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.6" />
                </Border.Effect>
            </Border>
            <Border CornerRadius="24" ClipToBounds="True" Background="{Binding Tint}">
                <Border.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border Width="216" Height="216" CornerRadius="24" Background="Black" />
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>
                <Grid>
                    <Image Stretch="UniformToFill" p:Art.Url="{Binding ArtUrl}" Width="216" Height="216" />
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.45" />
                                <GradientStop Color="#D0000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,16">
                        <TextBlock Style="{StaticResource TitleText}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Style="{StaticResource ArtistText}" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>
                    <ProgressBar Template="{StaticResource ThinProgress}" VerticalAlignment="Bottom" Height="3" Margin="16,0,16,8"
                                 Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position, Mode=OneWay}" Foreground="White"
                                 Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}" />
                    <Grid x:Name="SquareControls" Background="#80000000" Opacity="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" Width="40" Height="40" FontSize="18" Foreground="White" Command="{Binding PreviousCommand}" ToolTip="Previous" />
                            <Button Style="{StaticResource PlayButton}" Content="{Binding PlayGlyph}" Width="50" Height="50" FontSize="18" Margin="10,0" Command="{Binding PlayPauseCommand}" ToolTip="Play/Pause" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" Width="40" Height="40" FontSize="18" Foreground="White" Command="{Binding NextCommand}" ToolTip="Next" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
                            <Button Style="{StaticResource ToggleIconButton}" Content="{Binding LikeGlyph}" Width="28" Height="28" FontSize="13" Foreground="White"
                                    Tag="{Binding IsLiked, Converter={x:Static sh:BoolToOnConverter.Instance}}" Command="{Binding ToggleLikeCommand}" ToolTip="Save to Liked songs" />
                            <Button Style="{StaticResource PinButton}" Width="28" Height="28" FontSize="12" Click="Pin_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE740;" Width="28" Height="28" FontSize="12" Foreground="White" Click="Expand_Click" ToolTip="Open Tune" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="28" Height="28" FontSize="12" Foreground="White" Click="Hide_Click" ToolTip="Hide mini-player" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border CornerRadius="24" BorderBrush="#26FFFFFF" BorderThickness="1" IsHitTestVisible="False" />
        </Grid>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CompactCorner" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="SquareControls" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CompactCorner" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                    <DoubleAnimation Storyboard.TargetName="SquareControls" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
