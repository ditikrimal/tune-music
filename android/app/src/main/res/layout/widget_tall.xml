<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="10dp">

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ImageView android:id="@+id/widget_art" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:background="@drawable/widget_art_shape" android:clipToOutline="true"
            android:src="@drawable/widget_art_empty" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/widget_like" android:layout_width="38dp" android:layout_height="38dp" android:padding="8dp" android:src="@drawable/widget_heart_outline" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Like" android:layout_gravity="top|end" android:layout_margin="2dp" />
    </FrameLayout>

    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:paddingStart="2dp" android:paddingEnd="2dp"
        android:textColor="#FFF2F2F2" android:textSize="15sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="2dp" android:paddingEnd="2dp"
        android:textColor="#FFA7A7A7" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:orientation="horizontal" android:gravity="center">
        <ImageView android:id="@+id/widget_prev" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/widget_prev" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Previous"  />
        <FrameLayout android:id="@+id/widget_play" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_marginEnd="6dp">
                <ImageView android:id="@+id/widget_play_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_circle" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/widget_play_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:src="@drawable/widget_play" android:contentDescription="Play or pause" />
            </FrameLayout>
        <ImageView android:id="@+id/widget_next" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/widget_next" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Next"  />
    </LinearLayout>
</LinearLayout>
